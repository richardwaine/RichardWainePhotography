---
import FAQAccordion from "../components/FAQAccordion.astro";
import MainLayout from "../layouts/MainLayout.astro";
import ShareButtons from "../components/ShareButtons.astro";
import { buildBreadcrumbSchema, buildFAQSchema } from "../utils/schema";
import { Image } from 'astro:assets';
import preferredSourceBadge from '../assets/images/blog/google_preferred_source_badge_dark_en@2x.png';
import richardHeadshot from '../assets/images/about/Richard Waine 20230315 (500px).jpg';
import ShareIcon from '../components/icons/ShareIcon.astro';
import FacebookIcon from '../components/icons/FacebookIcon.astro';
import XTwitterIcon from '../components/icons/XTwitterIcon.astro';
import LinkedInIcon from '../components/icons/LinkedInIcon.astro';
import RedditIcon from '../components/icons/RedditIcon.astro';
import PinterestIcon from '../components/icons/PinterestIcon.astro';
import BlueskyIcon from '../components/icons/BlueskyIcon.astro';
import EnvelopeIcon from '../components/icons/EnvelopeIcon.astro';

export interface Props {
  title: string;
  post: any;
  prevPost?: any;
  nextPost?: any;
}

const { title, post, prevPost, nextPost } = Astro.props;

// Build breadcrumb navigation
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: Astro.site.href },
  { name: "Blog", url: new URL('/blog/', Astro.site).href },
  { name: post.data.blogTitle, url: new URL(`/blog/${post.id}/`, Astro.site).href }
]);

// Byline link: Richard's posts point to his About page; a guest post points to
// the address in its own authorUrl field, or shows the name unlinked if there is none
const isRichard = post.data.author === 'Richard Waine';
const bylineUrl = isRichard ? '/about-lancaster-headshot-photographer-richard-waine/' : post.data.authorUrl;

// The author link Google reads points to the same page as the visible byline,
// written out as a full address
const authorSchemaUrl = isRichard ? 'https://www.richardwainephotography.com/about-lancaster-headshot-photographer-richard-waine/' : post.data.authorUrl;

// Format the last updated date
const lastUpdated = new Date(post.data.modifiedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// --- NEW LINE HERE ---
// Get the faqs from the blog post's front matter.
// If there are no faqs, it will just be an empty list, which is fine.
const faqs = post.data.faqs || [];

// Generate FAQ schema if FAQs exist
const faqSchema = faqs.length > 0 ? buildFAQSchema(faqs) : null;

// --- END NEW LINE ---

// Determine if this is an interview post
const isInterview = post.data.type === 'interview';

// Calculate word count from post body
function countWords(content: string): number {
  // Remove frontmatter if present
  let text = content.replace(/^---[\s\S]*?---/, '');

  // Remove code blocks
  text = text.replace(/```[\s\S]*?```/g, '');
  text = text.replace(/`[^`]*`/g, '');

  // Remove HTML/JSX tags
  text = text.replace(/<[^>]*>/g, '');

  // Remove markdown images
  text = text.replace(/!\[.*?\]\(.*?\)/g, '');

  // Remove markdown links but keep link text
  text = text.replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1');

  // Remove markdown headers
  text = text.replace(/^#+\s+/gm, '');

  // Remove bold/italic markers
  text = text.replace(/(\*\*|__)(.*?)\1/g, '$2');
  text = text.replace(/(\*|_)(.*?)\1/g, '$2');

  // Remove extra whitespace and normalize
  text = text.replace(/\s+/g, ' ').trim();

  // Split on whitespace and count non-empty words
  const words = text.split(/\s+/).filter(word => word.length > 0);

  return words.length;
}

const wordCount = countWords(post.body);

// Share menu addresses, the same ones the share icons at the bottom use
const encodedUrl = encodeURIComponent(post.data.permalink);
const encodedTitle = encodeURIComponent(post.data.blogTitle);

---

<MainLayout title={title} description={post.data.blogExcerpt}>

	{isInterview ? (
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Interview",
			"headline": post.data.blogTitle,
			"description": post.data.blogExcerpt,
			"datePublished": post.data.publishDate,
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": post.data.permalink
			},
			"interviewer": {
				"@type": "Person",
				"name": "Richard Waine",
				"url": "https://www.richardwainephotography.com"
			},
			"publisher": {
				"@type": "Organization",
				"name": "Richard Waine Photography",
				"url": "https://www.richardwainephotography.com"
			},
			...(post.data.interviewee && {
				"interviewee": post.data.interviewee
			}),
			"image": post.data.headerImage?.src ? `https://www.richardwainephotography.com${post.data.headerImage.src.src}` : undefined
		})} />
	) : (
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Article",
			"headline": post.data.blogTitle,
			"author": {
				"@type": "Person",
				"name": post.data.author,
				"url": authorSchemaUrl,
				...(isRichard && { "sameAs": [
					"https://www.linkedin.com/in/richardwaine/",
					"https://www.instagram.com/richardwaine"
				] })
			},
			"datePublished": post.data.publishDate,
			"dateModified": post.data.modifiedDate,
			"publisher": {
				"@type": "Organization",
				"name": "Richard Waine Photography",
				"url": "https://www.richardwainephotography.com",
				"logo": {
					"@type": "ImageObject",
					"url": "https://www.richardwainephotography.com/Logo-RichardWainePhotography-black.png"
				},
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "20 North Queen Street",
					"addressLocality": "Lancaster",
					"addressRegion": "PA",
					"postalCode": "17603",
					"addressCountry": "US"
				}
			},
			"mainEntityOfPage": post.data.permalink,
			"description": post.data.blogExcerpt,
			"articleSection": post.data.articleSection,
			"keywords": post.data.keywords,
			"wordCount": wordCount,
			...(post.data.about && {
				"about": post.data.about
			}),
			"image": post.data.headerImage?.src ? `https://www.richardwainephotography.com${post.data.headerImage.src.src}` : undefined
		})} />
	)}

	<!-- Breadcrumb Schema -->
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- FAQ Schema -->
	{faqSchema && (
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	)}

  <article>
    <div class="wrapper">

      <h1 class="article-title">{title}</h1>
      <div class="article-meta-row">
      <div class="article-byline-stack">
      <p class="article-byline">{isRichard && <Image class="article-byline-photo" src={richardHeadshot} alt="Richard Waine" width={112} />}By {bylineUrl ? <a href={bylineUrl}>{post.data.author}</a> : post.data.author}</p>
      <p class="article-meta">Last Updated: {lastUpdated}</p>
      </div>
      <a class="preferred-source center" href="https://www.google.com/preferences/source?q=richardwainephotography.com" target="_blank" rel="noopener">
        <Image src={preferredSourceBadge} alt="Add as a preferred source on Google" width={160} height={50} densities={[1, 2]} />
      </a>
      <button type="button" class="share-toggle" aria-label="Share this post" popovertarget="share-menu"><ShareIcon /></button>
      <div id="share-menu" class="share-menu" popover>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer"><FacebookIcon /> Facebook</a>
        <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer"><XTwitterIcon /> X</a>
        <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer"><LinkedInIcon /> LinkedIn</a>
        <a href={`https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer"><RedditIcon /> Reddit</a>
        <a href={`https://www.pinterest.com/pin/create/link/?url=${encodedUrl}&description=${encodedTitle}`} target="_blank" rel="noopener noreferrer"><PinterestIcon /> Pinterest</a>
        <a href={`https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer"><BlueskyIcon /> Bluesky</a>
        <a href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}><EnvelopeIcon /> Email</a>
      </div>
      </div>

        <div class="article-content">
           
          
          <slot />
        
        
        </div>
      
    </div>



{/* --- NEW SECTION HERE --- */}
    {/* Only show the FAQ section if there are FAQs to display */}
    {faqs.length > 0 && (
      <section>
        <h2 class="blog-faq-title">Frequently Asked Questions</h2>
        {/* Pass the 'faqs' list to your FAQAccordion component */}
        <FAQAccordion faqs={faqs} />
      </section>
    )}
    {/* --- END NEW SECTION --- */}

{/* --- SHARE BUTTONS --- */}
    <ShareButtons url={post.data.permalink} title={post.data.blogTitle} />
{/* --- END SHARE BUTTONS --- */}

{/* --- POST NAVIGATION --- */}
    {(prevPost || nextPost) && (
      <nav class="post-navigation">
        <div class={`nav-container ${!prevPost && nextPost ? 'next-only' : ''} ${prevPost && !nextPost ? 'prev-only' : ''}`}>
          {prevPost && (
            <a href={`/blog/${prevPost.id}/`} class="nav-link prev-link">
              <span class="nav-arrow">←</span> {prevPost.data.blogTitle}
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}/`} class="nav-link next-link">
              {nextPost.data.blogTitle} <span class="nav-arrow">→</span>
            </a>
          )}
        </div>
      </nav>
    )}
    {/* --- END POST NAVIGATION --- */}

  </article>



</MainLayout>





<style is:global>

.wrapper{
  margin-top:calc(var(--header-height) + var(--size-7));
  margin-bottom:var(--size-7);
}

/*blog posts*/



.article-title {
  text-align: center;
  margin-top: var(--size-8);
  font-size: var(--fs-750);
  font-weight: var(--fw-bold);
  color: var(--blkclr);


}

.article-byline {
  text-align: left;
  font-size: var(--fs-400);
  margin-top: var(--size-3);
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: var(--size-2);
}

/* the author's photo as a small circle in front of the name */
.article-byline-photo {
--_size:3.25em;

  width: var(--_size);
  height: var(--_size);
  border-radius: 50%;
  object-fit: cover;
}

/* the author's name keeps the normal text color instead of link blue */
.article-byline a {
  color: inherit;
  font-weight:var(--fw-normal);
}

.article-meta {
  text-align: left;
  font-size: var(--fs-350);
  color: var(--faded);
  margin-top: var(--size-2);
  margin-bottom: var(--size-6);
}

/* the share button shows only the icon, without the browser's button look */
.share-toggle {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: var(--blkclr);
  anchor-name: --share-toggle;
}

/* the share menu opens just under the share button, lined up with its right edge */
.share-menu {
  position-anchor: --share-toggle;
  position-area: bottom span-left;
  /* opens above the share button when there is no room below it */
  position-try-fallbacks: flip-block;
  inset: auto;
  margin-top: var(--size-3);
  background: var(--ltclr);
  border: none;
  box-shadow: 0 10px 20px var(--shadow-clr-subtle);
  padding: var(--size-3) var(--size-5);
 
 
}

/* the open menu is a grid, icons in one column and names in the other */
.share-menu:popover-open {
  display: grid;
  grid-template-columns: auto 1fr;
}

/* each share link is one row of that grid, icon beside its name */
.share-menu a {
  display: grid;
  grid-column: 1 / -1;
  grid-template-columns: subgrid;
  align-items: center;
  gap: var(--size-9);
  padding-block: var(--size-2);
  color: var(--blkclr);
  font-weight: var(--fw-normal);
  /* the row reaches the menu's edges so the hover band runs edge to edge */
  margin-inline: calc(var(--size-5) * -1);
  padding-inline: var(--size-5);
  transition: color 0.2s ease, background-color 0.2s ease;
}

/* the row under the mouse gets a light gray band and turns blue */
.share-menu a:hover {
  background-color: var(--drkbg);
  color: var(--accent);
}

/* the hovered row's icon takes the accent color */
.share-menu a:hover svg {
  color: var(--accent);
}

.share-menu svg {
  --_icon-size:20px;

  width: var(--_icon-size);
  height: var(--_icon-size);
}

.share-toggle svg {
  --_icon-size:28px;

  width: var(--_icon-size);
  height: var(--_icon-size);
}

.preferred-source{
  display:block;
  width:fit-content;
  margin-inline:auto;
  margin-bottom:var(--size-6);
}

/* date at the left, Preferred Source badge and share button together at the right */
.article-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--size-3);
  margin-top: var(--size-10);
  margin-bottom: var(--size-6);
  justify-content: center;

  /* pulled in from both sides by a share of the page width, so it scales with the screen */
    @media (min-width: 48em) {
      padding-inline: 8%;
    }
}

/* byline with the date right under it */
.article-byline-stack {
  display: flex;
  flex-direction: column;
  gap: var(--size-2);

  /* phones: byline and date centered on their own line, badge and share centered under them */
  flex-basis: 100%;
  align-items: center;

    @media (min-width: 48em) {
      flex-basis: auto;
      align-items: flex-start;
    }
}

.article-byline-stack > p,
.article-meta-row > .preferred-source {
  margin: 0;
}

.article-meta-row > .preferred-source {
    @media (min-width: 48em) {
      margin-left: auto;
    }
}

.article-content{
padding-block:var(--size-3);


   @media (min-width: 48em) {
      padding-block:var(--size-4);
    }
}

.article-content em{
    display:block;
    text-align:center;
    margin-inline:auto;
    margin-bottom:var(--size-8);
   
  }

 .inline-em{
  font-style: italic;
 }

.article-content img{
  margin-block:var(--size-7);
  display: block;
  width: min(600px, 100%);
  height:auto;
  margin-inline: auto;

    @media (min-width: 48em) {
      margin-block:var(--size-9);
    }
}

.article-header-image{
margin-block:var(--size-7);

  display:block;
  width:min(600px, 100%);
  height:auto;
  margin-inline:auto;
  box-shadow:var(--shadow);


    @media (min-width: 48em) {
    margin-block:var(--size-9);
  }
}


.article-content > :is(p, div, figure):has(img):not(:has(img) ~ *) img, .article-header-image{
  box-shadow: var(--shadow);
}
/*blog posts*/



article ul{
  padding-inline:0;
}

article li{
    list-style:none;
    margin-block:var(--size-2);
 }

.table-of-contents{
  margin-block:var(--size-7);

   }


.references{
  margin-block:var(--size-8);
  font-size:var(--fs-400);

    > p{
    text-align:center
  }
}


/* Mobile-First Replacement */
.references-list {
  columns: 1;
  gap: var(--size-7);

      @media (min-width: 48em) {
        columns: 2;
        }
      }



.table-of-contents li, .references li{
  margin-block:var(--size-1);
  line-height:2; 
  font-size:var(--fs-400);
    }


 article a{
    border:none;
    text-decoration:none;
    font-weight:var(--fw-bold);
    cursor:pointer;
    color:blue;
    font-weight:bold;
  }

article p{
  margin-bottom:var(--size-5);
  line-height:var(--line-height-relaxed);
}

article h2, article h3{
font-size:var(--fs-600);
font-weight:var(--fw-bold);
margin-block:var(--size-8) var(--size-7);

}

article h3{
  font-size:var(--fs-400);
}

.subtitle{
  font-size:var(--fs-400);
  max-inline-size:65ch;
  margin:auto;

}


hr{
margin:var(--size-9) auto;

 
}



.hs-infographic{
width:min(600px,100%);
height:auto;
display:block;
margin:var(--size-7) auto;

}


/*end blog posts*/

.blog-faq-title {
  text-align: center;
}

/* FAQ accordion in blog articles */
article .article-content .faq-content {
  width: 100%;
  margin-inline: auto;
  margin-block: var(--size-10);

      @media (min-width:64em){
      width: 50%;
    }
}

/* Post Navigation */
.post-navigation {
  margin-block: var(--size-7);
  padding-bottom:var(--size-7);

}

.nav-container {
  display: flex;
  justify-content: space-between;
  width: calc(100% - 2em);
  margin-inline:auto;
  align-items:baseline;

@media (min-width:64em){
      width: 80%;
      font-size:var(--fs-450);
    }
}

.nav-container.next-only {
  justify-content: flex-end;
}

.nav-container.prev-only {
  justify-content: flex-start;
}

.nav-link {
  text-decoration: none;
  color: var(--blkclr);
  font-weight: var(--fw-semi-bold);
  transition: color 0.2s ease;
  
}

.nav-link:hover {
  color: blue;
}

.nav-arrow{
font-size:var(--fs-600);
padding-inline:.125rem;
}

.prev-link {
  text-align: left;
}

.next-link {
  text-align: right;
}

</style>