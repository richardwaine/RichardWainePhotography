---
// The three sliding panels every service page carries: the headline and
// "why" box, the Experience and Process boxes, and the Expectations box.
// Each service page passes in its own words; the layout lives here once.
import { Image } from 'astro:assets';
import StudioBTS from "../../assets/images/blog/RW14 - (16 x 9).jpg"
import StudioBTSTwo from "../../assets/images/blog/RW8 - (16 x 9).jpg"

interface Step { title: string; line: string }
interface Fact { title: string; detail: string }

export interface Props {
  headlineLines: string[];
  headlineAccent: string;
  whyTitle: string;
  whyParagraphs: string[];
  experienceTitle?: string;
  experienceParagraphs: string[];
  processTitle?: string;
  steps?: Step[];
  expectationsTitle?: string;
  expectationsParagraph: string;
  facts: Fact[];
}

const {
  headlineLines,
  headlineAccent,
  whyTitle,
  whyParagraphs,
  experienceTitle = "THE EXPERIENCE",
  experienceParagraphs,
  processTitle = "THE PROCESS",
  steps = [
    { title: "Schedule", line: "Your preparation guide arrives with confirmation" },
    { title: "Arrive", line: "We talk together before anything begins" },
    { title: "Photograph", line: "I coach and direct every expression" },
    { title: "Select", line: "We select your favorite images together" },
    { title: "Retouch", line: "My retoucher finishes every chosen image" },
    { title: "Deliver", line: "Your images arrive in multiple crops" }
  ],
  expectationsTitle = "EXPECTATIONS",
  expectationsParagraph,
  facts
} = Astro.props;

/* one icon per process step, in step order */
const icons = [
  `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="6" width="30" height="28" rx="2" stroke="#03a9f4" stroke-width="1.2"/>
                    <line x1="4" y1="14" x2="34" y2="14" stroke="#03a9f4" stroke-width="1.2"/>
                    <line x1="13" y1="6" x2="13" y2="14" stroke="#03a9f4" stroke-width="1.2"/>
                    <line x1="25" y1="6" x2="25" y2="14" stroke="#03a9f4" stroke-width="1.2"/>
                    <circle cx="19" cy="24" r="1.5" fill="#03a9f4"/>
                  </svg>`,
  `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="6" width="22" height="28" rx="2" stroke="#03a9f4" stroke-width="1.2"/>
                    <circle cx="26" cy="20" r="1.5" fill="#03a9f4"/>
                    <path d="M8 6 L8 34" stroke="#03a9f4" stroke-width="1.2"/>
                    <path d="M4 10 L4 30" stroke="#03a9f4" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>`,
  `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="9" width="30" height="22" rx="3" stroke="#03a9f4" stroke-width="1.2"/>
                    <circle cx="19" cy="20" r="7" stroke="#03a9f4" stroke-width="1.2"/>
                    <circle cx="19" cy="20" r="3" stroke="#03a9f4" stroke-width="1.2"/>
                    <circle cx="29" cy="13.5" r="1.5" fill="#03a9f4"/>
                  </svg>`,
  `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="6" width="12" height="12" stroke="#03a9f4" stroke-width="1.2"/>
                    <rect x="20" y="6" width="12" height="12" stroke="#03a9f4" stroke-width="1.2"/>
                    <rect x="4" y="22" width="12" height="12" stroke="#03a9f4" stroke-width="1.2"/>
                    <rect x="20" y="22" width="12" height="12" stroke="#03a9f4" stroke-width="1.2"/>
                    <polyline points="23 28 26 31 30 25" stroke="#03a9f4" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>`,
  `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="4" y1="8" x2="34" y2="8" stroke="#03a9f4" stroke-width="1.2" stroke-linecap="round"/>
                    <circle cx="24" cy="8" r="2.5" stroke="#03a9f4" stroke-width="1.2" fill="#121212"/>
                    <line x1="4" y1="20" x2="34" y2="20" stroke="#03a9f4" stroke-width="1.2" stroke-linecap="round"/>
                    <circle cx="15" cy="20" r="2.5" stroke="#03a9f4" stroke-width="1.2" fill="#121212"/>
                    <line x1="4" y1="32" x2="34" y2="32" stroke="#03a9f4" stroke-width="1.2" stroke-linecap="round"/>
                    <circle cx="27" cy="32" r="2.5" stroke="#03a9f4" stroke-width="1.2" fill="#121212"/>
                  </svg>`,
  `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 8 L19 20 L34 8" stroke="#03a9f4" stroke-width="1.2" stroke-linejoin="round"/>
                    <rect x="4" y="8" width="30" height="24" rx="2" stroke="#03a9f4" stroke-width="1.2"/>
                  </svg>`
];
---

<section class="persuasion" data-persuasion data-service-panels>
  <div class="slides-viewport">
    <div class="slides-track" data-slides-track>

      <div class="backdrop-photo" data-backdrop>
        <Image src={StudioBTS}
          alt="Richard Waine setting a light modifier during a headshot session in his Lancaster PA studio"
          widths={[1200, 1800, 2400]} sizes="160vw" loading="lazy" />
        <Image src={StudioBTSTwo}
          alt="Headshot session underway in the Lancaster PA studio of Richard Waine Photography"
          widths={[1200, 1800, 2400]} sizes="160vw" loading="lazy" />
      </div>

      <section class="slide">
        <div class="slide-content">
          <div class="slide-headline">
            <h2>{headlineLines.map((line) => <Fragment>{line} <br></Fragment>)}<span class="headline-accent">{headlineAccent}</span></h2>
          </div>
          <div class="glass-box">
            <h3>{whyTitle}</h3>
            {whyParagraphs.map((text) => <p set:html={text} />)}
          </div>
        </div>
      </section>

      <section class="slide">
        <div class="slide-content">
          <div class="glass-box">
            <h3>{experienceTitle}</h3>
            {experienceParagraphs.map((text) => <p set:html={text} />)}
          </div>
          <div class="glass-box is-wide">
            <h3>{processTitle}</h3>
            <div class="process-steps">
              {steps.map((step, i) => (
                <div>
                  <Fragment set:html={icons[i]} />
                  <div class="step-body">
                    <h4>{step.title}</h4>
                    <p>{step.line}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="slide">
        <div class="slide-content">
          <div class="glass-box is-full-width">
            <h3>{expectationsTitle}</h3>
            <p set:html={expectationsParagraph} />
            <div class="fact-grid">
              {facts.map((fact) => <div class="fact"><b>{fact.title}</b><span>{fact.detail}</span></div>)}
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</section>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

/* The sideways sliding exists at desktop only. Below 90em the panels
   are stacked and scroll normally, so neither tween is created. */
document.addEventListener('astro:page-load', () => {
  const persuasionSection = document.querySelector<HTMLElement>('[data-service-panels]');
  if (!persuasionSection) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = gsap.context(() => {
    let mm = gsap.matchMedia();

    mm.add("(min-width: 90em)", () => {
      const scene = document.querySelector<HTMLElement>('[data-slides-track]');
      if (scene) {
        gsap.to(scene, {
          x: () => -(scene.scrollWidth - window.innerWidth),
          ease: 'none',
          scrollTrigger: {
            trigger: persuasionSection,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1,
            invalidateOnRefresh: true
          }
        });

        gsap.to('[data-backdrop]', {
          x: '20%',
          ease: 'none',
          scrollTrigger: {
            trigger: persuasionSection,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1
          }
        });
      }
    });
  }, persuasionSection);

  document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
});
</script>

<style>
  /* --section-space comes from the page (.page), so the panels share the
     page's vertical rhythm */

  /* links inside the panels stay the color of the text around them */
  /* the paragraphs arrive as passed-in HTML, so their links need :global
     to be reached from this component's styles */
  .persuasion :global(a) {
    color: inherit;
  }

  /* ---------- the three panels ----------
     On phones and tablets they stack top to bottom and scroll normally.
     The sideways sliding and the pinned viewport are switched on at
     desktop. */
  .persuasion {
    position: relative;
    background: var(--drkbg);
    color: var(--ltclr);
    font-family: var(--ff-primary);
    text-align: left;
    padding-block: var(--section-space);
    overflow: clip;
  }

  .persuasion .slides-viewport {
    position: relative;
    width: 100%;
  }

  .persuasion .slides-track {
    position: relative;
    display: grid;
    gap: var(--section-space);
  }

  .persuasion .slide {
    position: relative;
    width: 100%;
  }

  /* BACKGROUND PHOTOGRAPHS (STAY BEHIND)
     Stacked one above the other behind the panels, exactly the width of
     the screen and held still below desktop. */
  .persuasion .backdrop-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.4;
    display: grid;
    grid-template-rows: 1fr 1fr;
  }
  .persuasion .backdrop-photo img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1);
  }
  /* Richard stands 40% in from the left of the first photograph, so the
     narrow phone crop is centred on him rather than on the middle of the
     frame */
  .persuasion .backdrop-photo img:first-child {
    object-position: 40% 30%;
  }

  /* EDUCATION MODULES: one column on the page's content edge */
  .persuasion .slide-content {
    position: relative;
    z-index: 10;
    width: min(calc(100% - var(--size-8)), 80%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--size-7);
  }

 

  /* the hero's treatment: white, with the closing word in the accent */
  .persuasion .slide-headline h2 {
    color: var(--ltclr);
    font-size: var(--fs-clamp-xxl);
    line-height: var(--line-height-dramatic);
    margin: 0;
    text-transform: uppercase;
    text-align: left;
    font-weight: var(--fw-x-bold);
  }

   .persuasion .slide-content h2{
      text-align: center;
      padding-top:1em; 
   
    }


  .persuasion .slide-headline .headline-accent {
    color: var(--accent);
  }

  /* the glass surface, defined once, used by every box on this page. The
     box owns the rhythm between its children, so nothing inside it carries
     its own margin. The padding grows with the screen and lands on
     --size-9 at desktop. */
  .glass-box {
    width: 100%;
    display: grid;
    align-content: start;
    gap: var(--size-5);
    background: rgba(255, 255, 255, 0.02);
    border-left: 1px solid var(--accent);
    padding: clamp(var(--size-5), 5vw, var(--size-9));
    /* light blur below desktop, so the photograph behind reads through
       the panel where there is no open ground beside it */
    backdrop-filter: blur(var(--size-1));
  }

  /* the one box that runs the full module */
  .persuasion .glass-box.is-full-width {
    grid-column: 1 / -1;
  }

  .persuasion h3 {
    color: var(--accent);
    line-height: var(--line-height-tight);
    font-size: var(--fs-clamp-lg);
    margin: 0;
    text-transform: uppercase;
    font-weight: var(--fw-bold);
  }

  .persuasion p {
    line-height: var(--line-height-relaxed);
    font-size: var(--fs-400);
    margin: 0;
  }

  /* the stages, one per row on a phone. Every row is the same height,
     the accent line runs the full width above it, and the icon and the
     words sit centred on each other. */
  .persuasion .process-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--size-5);
  }
  .persuasion .process-steps > div {
    display: grid;
    /* grid-template-columns: auto minmax(0, 1fr); */
    grid-template-columns: 1fr 2fr;
    align-items: center;
    gap: var(--size-5);
    padding-block-start: var(--size-5);
    border-top: 1px solid var(--accent);
  }
  .persuasion .process-steps .step-body {
    display: grid;
    align-content: start;
    gap: var(--size-3);
  }
  .persuasion .process-steps h4 {
    font-size: var(--fs-clamp-sm);
    font-weight: var(--fw-semi-bold);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ltclr);
  }
  .persuasion .process-steps p {
    font-size: var(--fs-350);
    line-height: var(--line-height-relaxed);
    text-wrap:balance;
    
  }

  /* DATA GRID: one fact per row on a phone, centred; two across from tablet up */
  .persuasion .fact-grid {
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
    gap: var(--size-6);
    border-top: 1px solid var(--highlight-clr-soft);
    padding-block-start: var(--size-6);
  }

  .persuasion .fact {
    display: grid;
    gap: var(--size-1);
  }

  .persuasion .fact b {
    color: var(--ltclr);
    font-size: var(--fs-350);
    text-transform: uppercase;
  }

  .persuasion .fact span {
    color: var(--accent);
    font-size: var(--fs-350);
  }

  /* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
  @media (min-width: 48em) {
    .persuasion .fact-grid {
      grid-template-columns: 1fr 1fr;
    }

    .persuasion .process-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--size-8);
    }
    .persuasion .process-steps {
      grid-auto-rows: auto;
    }
    .persuasion .process-steps > div {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      align-items: start;
      padding-block-start: 0;
      border-top: 0;
    }
    .persuasion .process-steps .step-body {
      gap: var(--size-4);
      padding-block-start: var(--size-5);
      border-top: 1px solid var(--accent);
    }
  }

  /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     The sideways sliding, exactly as before.
     ========================================== */
  @media (min-width: 90em) {
    .persuasion {
      height: 600vh;
      padding-block: 0;
      overflow: visible;
    }

    /* 3D ENGINE */
    .persuasion .slides-viewport {
      position: sticky;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      perspective: 1200px;
      overflow: hidden;
    }
    .persuasion .slides-track {
      position: absolute;
      /* the pen relies on the static position being the top-left corner; on
         this page inherited text-align pushes it, so it is anchored */
      top: 0;
      left: 0;
      height: 100%;
      display: flex;
      gap: 0;
      will-change: transform;
      transform-style: preserve-3d;
    }

    /* SECTIONS */
    .persuasion .slide {
      width: 100vw;
      height: 100vh;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-style: preserve-3d;
    }

    /* BACKGROUND PORTRAIT (STAYS BEHIND) */
    .persuasion .backdrop-photo {
      position: absolute;
      display: flex;
      gap: 0;
      width: 320vw;
      height: 100vh;
      top: 0;
      left: 0;
    }
    .persuasion .backdrop-photo img {
      flex: 0 0 160vw;
      width: 160vw;
      height: 100%;
      aspect-ratio: auto;
    }
    /* both photographs framed as they were, centred */
    .persuasion .backdrop-photo img,
    .persuasion .backdrop-photo img:first-child {
      object-position: 50% 30%;
    }

    /* narrower box than the first frame, so less of this photograph is cropped */
    .persuasion .backdrop-photo .backdrop-photo-second {
      flex: 0 0 140vw;
      width: 140vw;
    }

    /* EDUCATION MODULES: content sits to the left of the subject */
    .persuasion .slide-content {
      width: 80%;
      max-width: 1200px;
      margin-inline: 10% auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--size-7) var(--size-11);
      transform: translateZ(50px);
      align-items: center;  
   
    }

    .persuasion .slide-headline h2 {
      font-size: clamp(3.75rem, 3vw, 6rem);
      text-align: left;
      padding-top: 0;
    }

    .glass-box {
      padding: var(--size-9);
      backdrop-filter: blur(var(--size-4));
    }

    .persuasion .glass-box.is-full-width {
      width: 75%;
    }

    /* the process box runs past its column and on towards the next screen.
       Change this one number to set how far. 100% keeps it in its column. */
    .persuasion .glass-box.is-wide {
      /* runs past its column towards the next screen, and stops before
         the next screen's box */
      width: 140%;
      align-self: center;
      /* margin-inline-start:12em; */

    }

    .persuasion h3 {
      font-size: var(--fs-800);
    }

    .persuasion .fact-grid {
      text-align: left;
    }
  }

  /* ==========================================
     WIDE DESKTOP - min-width: 106.0625em (1697px)
     ========================================== */
  @media (min-width: 106.0625em) {
    .persuasion .slide-content {
      align-items: start;
    }
  }

  /* ==========================================
     LARGEST DESKTOP - min-width: 150em (2400px)
     The process strip returns: six steps across.
     ========================================== */
  @media (min-width: 150em) {
    .persuasion .glass-box.is-wide {
      width: 310%;
      margin-inline-start:0;
      
    }

    .persuasion .process-steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
