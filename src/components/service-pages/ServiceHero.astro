---
// @ts-nocheck
import { Image } from 'astro:assets';
import PrimaryButton from "../PrimaryButton.astro"
import SecondaryButton from '../SecondaryButton.astro'

export interface Props {
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;
  heroButtonUrl?: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
  heroBg?: any;
  heroBgAlt?: string;
  portraitImage?: any;
  portraitAlt?: string;
  portraitWidth?: number;
  portraitHeight?: number;
  callout1?: string;
  callout2?: string;
  callout1Corner?: string; // 'top-right' (default) or 'top-left'
  callout2Corner?: string; // 'bottom-left' (default) or 'bottom-right'
  stats?: { v: string; l: string }[]; // optional spec line at the foot of the hero
  serviceAreaIntro?: string;
  serviceAreas?: { label: string; url: string }[];
}

const {
  heroTitle,
  heroTitleAccent,
  heroDescription,
  heroButtonText,
  heroButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
  heroBg,
  heroBgAlt,
  portraitImage,
  portraitAlt,
  portraitWidth = 600,
  portraitHeight = 480,
  callout1,
  callout2,
  callout1Corner = 'top-right',
  callout2Corner = 'bottom-left',
  stats = [],
  serviceAreaIntro = 'Sessions available in',
  serviceAreas = [
      { label: 'Lancaster PA', url: '/' },
      { label: 'Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'Baltimore', url: '/baltimore-headshots/' },
      { label: 'Harrisburg', url: '/harrisburg-headshots/' },
      { label: 'York', url: '/york-headshots/' },
      { label: 'Delaware', url: '/delaware-headshots/' },
    ],

} = Astro.props;
---

<section class="hero">


<Image
    class="hero-bg"
    src={heroBg}
    alt={heroBgAlt}
    loading="eager"
    fetchpriority="high"
    widths={[400, 600, 800, 1200, 1600]}
    sizes="100vw"
/>





    <div class="hero-text">
        <h1>{heroTitle} <br><span class="cyan">{heroTitleAccent}</span></h1>
        <p class="hero-p">{heroDescription}</p>
        <p class="hero-p service-areas">
          {serviceAreaIntro}{' '}
          {serviceAreas.map((area, i) => (
            <>
              <a href={area.url}>{area.label}</a>{i < serviceAreas.length - 2 ? ', ' : i === serviceAreas.length - 2 ? ', and ' : '.'}
            </>
          ))}
        </p>

        <div class="action-group">
          <div class="button-wrapper">
            <PrimaryButton text={heroButtonText} url={heroButtonUrl}/>
        </div>

        <div class="button-wrapper">
            <SecondaryButton text={secondaryButtonText} url={secondaryButtonUrl}/>
        </div>
    </div>

    </div>

    <div class="hero-visual">
        <div class="blueprint-box">
            <div class="portrait-sim">
              <Image src={portraitImage} alt={portraitAlt} width={portraitWidth} height={portraitHeight}/>
            </div>

            <div class={`callout c-1 ${callout1Corner}`}>{callout1}</div>
            <div class={`callout c-2 ${callout2Corner}`}>{callout2}</div>
        </div>
    </div>

    {stats.length > 0 && (
      <dl class="hero-spec">
        {stats.map((s) => (
          <div class="hero-spec-i">
            {/* The value is written once, by the page that passes it in.
                The count-up target is read back off that same value at build
                time, so there is no second copy of the number anywhere. */}
            <dt
              data-count={String(s.v).replace(/[^0-9]/g, '')}
              data-suffix={String(s.v).replace(/^[\d,]+/, '')}
            >{s.v}</dt>
            <dd>{s.l}</dd>
          </div>
        ))}
      </dl>
    )}

    {stats.length > 0 && (
      <script is:inline>
        /* Hero is above the fold, so zero them before the first paint —
           no flash of the final number. Width is the stylesheet's job. */
        document.querySelectorAll('.hero-spec dt').forEach(function (el) {
          el.textContent = '0' + (el.dataset.suffix || '');
        });
      </script>
    )}

</section>

<script>
function initHeroSpec() {
  const cells = document.querySelectorAll<HTMLElement>('.hero-spec dt');
  if (!cells.length) return;

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  cells.forEach((el, i) => {
    const target = Number(el.dataset.count || 0);
    const suffix = el.dataset.suffix || '';

    if (reduce || !target) {
      el.textContent = target.toLocaleString() + suffix;
      return;
    }

    const duration = 1400;
    const delay = i * 120;
    const start = performance.now() + delay;

    function step(now: number) {
      if (now < start) { requestAnimationFrame(step); return; }
      const p = Math.min((now - start) / duration, 1);
      /* ease out — fast at first, settles onto the number */
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(target * eased).toLocaleString() + suffix;
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  });
}

document.addEventListener('DOMContentLoaded', initHeroSpec);
document.addEventListener('astro:page-load', initHeroSpec);
</script>

<style>
.cyan {
  color: var(--accent);
}

/* Hero Section */
.hero {
  position: relative;
  align-items: center;
  padding-top:calc(var(--header-height) + var(--size-7));
  padding-bottom:var(--size-825);
  gap: var(--size-8);
  border-bottom: 1px solid var(--border);
  display:grid;
  grid-template-columns: 1fr;
  width:100%;
  margin-inline:auto;
  overflow:clip;
}

.hero-bg{

  position:absolute;
  inset:0;
  height:100%;
  width:100%;
  object-fit:cover;
  object-position:center var(--header-height);
  filter:grayscale(1);
  opacity:.25;
  z-index: -2;
  overflow:hidden;

}

.hero-text{
  margin-inline:auto;
  width:min(700px, calc(100% - var(--size-7)));
  text-align:center;
}

h1 {
  font-size: clamp(40px, 5vw, 70px);
  line-height: 1;
  margin-bottom: var(--size-4);
  font-weight: var(--fw-x-bold);
  text-transform: uppercase;

}

.hero-p {
  font-size: var(--fs-clamp-base);
  color: var(--text-dim);
  text-align:center;
  margin-bottom: var(--size-775);
}

.service-areas {
  font-size:var(--fs-400);
  color: var(--faded);
  text-wrap:balance;
}

.hero-p a{
  color:var(--faded);
}

.action-group{

  display:flex;
  flex-direction:column;
  justify-self:center;
  gap:var(--size-4);

}

.hero-visual {
  position: relative;
  justify-self: center;
  width:calc(100% - var(--size-7));

}

/* Blueprint Visuals */
.blueprint-box {
  --_width:min(700px, 80%);

  width:var(--_width);
  margin-inline:auto;
  height:auto;
  background:transparent;
  position: relative;
  overflow: hidden;
  perspective: 1200px;
  box-shadow: 0 10px 50px var(--shadow-clr-medium);

}

.portrait-sim {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #222;
  font-weight: var(--fw-x-bold);
  transform-style: preserve-3d;
  box-shadow: inset 0 0 60px rgba(3, 169, 244, 0.1);
  overflow:clip;

  > * {

  object-fit:cover;
  width:100%;
  height:100%;

}
}


.callout {
  display:none;

}

/* Spec block: the open ground at the lower left of the hero.
   One group, 2x2, on the text column's left edge. Only renders when
   stats are passed, and never affects the placement of anything else. */
.hero-spec {
  width: min(700px, calc(100% - var(--size-7)));
  margin: var(--size-9) auto 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  /* the wide column gap keeps each column narrower than the shortest
     label, so all four labels wrap to two lines alike */
  gap: var(--size-6) var(--size-10);
  text-align: center;

  
}

.hero-spec-i {
  display: grid;
  gap: var(--size-250);
  align-content: start;
}

.hero-spec dt {
  font-family: var(--ff-primary);
  font-size: var(--fs-500);
  font-weight: var(--fw-bold);
  line-height: 1;
  color: var(--ltclr);
  font-variant-numeric: tabular-nums lining-nums;
}

.hero-spec dd {
  margin: 0;
  font-size: 12px;
  letter-spacing: 2px;
  font-weight: bold;
  text-transform: uppercase;
  color: var(--accent);
  max-width:11.5em;
  margin-inline:auto;
}

/* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
        @media (min-width: 48em) {
           .hero-spec {
            column-gap: var(--size-5);
           }
           
          .hero-spec dd {
            white-space: nowrap;
            max-width:none;
          }


           .hero {
            min-height:100vh;
            grid-template-columns: 1fr;
            gap: var(--size-875);

          }

        

          .action-group{

          display:flex;
          flex-direction:row;
          }

          .callout{
            /* display:block; */
            display:none;
            position: absolute;
            color: var(--accent);
            font-size: 12px;
            letter-spacing: 2px;
            font-weight: bold;
            border-bottom: 1px solid var(--accent);
            padding-bottom: var(--size-1);
            z-index: 10;

          }
          .c-1 {
            top: 25%;
          }
          .c-2 {
            bottom: 25%;
          }
          .c-1.top-right { right: 5%; }
          .c-1.top-left { left: 5%; }
          .c-2.bottom-left { left: 5%; }
          .c-2.bottom-right { right: 5%; }

  }


 /* ==========================================
     DESKTOP - min-width: 64em (1024px)
     ========================================== */
  @media (min-width: 64em) {
    

  }

 /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     ========================================== */
  @media (min-width: 90em) {
        /* one row across the full width, directly beneath both columns.
           out of flow, so nothing else moves. */
        /* the gradient is its own layer so it cannot catch clicks */
        .hero::before {
          content: "";
          position: absolute;
          left: 0;
          right: 0;
          top: 58%;
          bottom: 0;
          pointer-events: none;
          background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(0,0,0,0.30) 45%,
            rgba(0,0,0,0.70) 78%,
            rgba(0,0,0,0.86) 100%
          );
        }

        /* pinned to the bottom of the hero, only as tall as the numbers */
        .hero-spec {
          position: absolute;
          left: 0;
          right: 0;
          bottom: 0;
          width: auto;
          margin: 0;
          padding: 0 10% var(--size-11);
          grid-template-columns: repeat(4, auto);
          grid-auto-rows: max-content;
          justify-content: center;
          gap: var(--size-11);
          text-align: left;
        }
  }
 /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     ========================================== */
  @media (min-width: 90em) {

        .hero {
            grid-template-columns: 1fr 1fr;
            /* the two columns sit inside the same 10% inset the stat row uses */
            padding-inline: 10%;
          }

    

          .blueprint-box {
            --_width: min(700px, 100%);
          }

          h1 {

            margin-inline:0;
            text-align:left;
            margin-bottom: var(--size-2);
            width:calc(100% - var(--size-7));

          }

          .hero-p{
            text-align:left;
          }

          .hero-p:not(.service-areas){
            font-size: var(--fs-500);
          }


        .action-group{
            flex-direction:row;
            justify-self: flex-start;
          }

  }
</style>
