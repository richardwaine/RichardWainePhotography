---
import { Image } from 'astro:assets';

export interface Props {

  imageSrc: string;
  image: any;
  imageAlt: string;
  author: string;
  testimonialText: string;
  company: string;
}

const { testimonialText, author, company, imageSrc, image, imageAlt } = Astro.props;
---

<blockquote class="testimonial-card-2" data-reveal>
  <p>{testimonialText}</p>
  <footer class="testimonial-author-2">
    <Image src={image} alt={imageAlt} widths={[96, 144]} sizes="64px" />
    <span><b>{author}</b>{company}</span>
  </footer>
</blockquote>

<style>
  /* the glass box, skewed — self-contained so the card carries its own look */
  .testimonial-card-2 {
    width: 100%;
    margin: 0;
    display: grid;
    align-content: start;
    gap: var(--size-6);
    background: rgba(255, 255, 255, 0.02);
    border-left: 1px solid var(--accent);
    padding: clamp(var(--size-5), 5vw, var(--size-9));
    backdrop-filter: blur(var(--size-1));
  }

  /* a set opening quotation mark, counter-skewed like the content and given a
     short box so the glyph overhangs rather than pushing the words down */
  .testimonial-card-2::before {
    content: "\201F";
    height: 0.35em;
    color: var(--accent);
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    opacity: 1;
  }

  .testimonial-card-2 p {
    margin: 0;
    font-size: var(--fs-clamp-sm);
    line-height: var(--line-height-loose);
    color: var(--ltclr);
    text-wrap: pretty;
  }

  .testimonial-author-2 {
    display: flex;
    align-items: center;
    gap: var(--size-5);
  }

  .testimonial-author-2 img {
    width: var(--size-9);
    height: var(--size-9);
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 10px 24px -10px var(--shadow-clr-deep);
  }

  .testimonial-author-2 span {
    display: grid;
    gap: var(--size-05);
    font-size: var(--fs-300);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ltr-space);
    text-transform: uppercase;
    color: var(--accent);
  }

  .testimonial-author-2 b {
    font-size: var(--fs-400);
    letter-spacing: 0;
    text-transform: none;
    font-weight: var(--fw-semi-bold);
    color: var(--ltclr);
  }

  /* the slant is added at tablet, where the side margins have room for it.
     On a phone it pushed the card past both screen edges. */
  @media (min-width: 48em) {
    .testimonial-card-2 {
      transform: skewX(-6deg);
    }

    .testimonial-card-2 > * {
      transform: skewX(6deg);
    }

    .testimonial-card-2::before {
      transform: skewX(6deg);
    }
  }

  @media (min-width: 90em) {
    .testimonial-card-2 {
      padding: var(--size-9);
      backdrop-filter: blur(var(--size-4));
    }
  }
</style>
