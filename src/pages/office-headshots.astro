---
// @ts-nocheck
import MainLayout from "../layouts/MainLayout.astro"
import Testimonials2 from '../components/Testimonials2.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Gallery from '../components/Gallery.astro';
import ServiceHero from '../components/service-pages/ServiceHero.astro';
import ServicePanels from '../components/service-pages/ServicePanels.astro';
import { buildServiceSchema, buildReviewSchema, buildFAQSchema } from '../utils/schema';
import { reviewCount, yearsExperience } from '../data/testimonials';


import Chubb from "../assets/images/features/Chubb - ContactSheet (square).jpg"
import RW2 from "../assets/images/blog/RW7 - (16 x 9).jpg"



export interface Props {
  // SEO
  pageTitle?: string;
  metaDescription?: string;

  // Hero Section
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;

  // Blueprint Callouts
  callout1?: string;
  callout2?: string;

  // Button URLs
  heroButtonUrl?: string;

  // Service Panels
  panelHeadlineLines?: string[];
  panelHeadlineAccent?: string;
  whyTitle?: string;
  whyParagraphs?: string[];
  experienceParagraphs?: string[];
  steps?: { title: string; line: string; icon?: string }[];
  expectationsParagraph?: string;
  facts?: { title: string; detail: string }[];
  logistics?: { label: string; value: string }[];
}

const {
  pageTitle = 'Office Headshots | Richard Waine Photography',
  metaDescription = 'Professional on-location office headshots by Richard Waine Photography. Unified team images with expert direction and instant image selection. Request your proposal today.',

  heroTitle = 'Office',
  heroTitleAccent = 'Headshots',
  heroDescription = 'Your people are the most visible extension of the brand and values you have worked hard to build. I bring a full studio to your office and create team headshots that are unified, polished, and consistent, giving your brand greater respect and authority.',
  heroButtonText = 'REQUEST PROPOSAL',
  SecondaryButtonText = 'SCHEDULE CONSULT',

  callout1 = 'UNIFIED',
  callout2 = 'CONSISTENT',

  heroButtonUrl = '/request-proposal',
  SecondaryButtonUrl = "https://app.acuityscheduling.com/schedule/f0843291/appointment/11959793/calendar/1133425?appointmentTypeIds[]=11959793",

  // Service Panels (the three sliding panels)
  panelHeadlineLines = ["THE", "OFFICE", "HEADSHOT"],
  panelHeadlineAccent = "EXPERIENCE",
  whyTitle = "WHY YOUR TEAM NEEDS PROFESSIONAL OFFICE HEADSHOTS",
  whyParagraphs = [

    `Mismatched photos make your team look like a collection of freelancers instead of a unified organization. When every headshot has different lighting, backgrounds and quality, it signals inconsistency. Clients notice. They wonder if the company pays the same attention to their work as they do to their image.`,

    `<a href="/blog/what-is-a-professional-headshot/">Professional headshots</a> that match in style and quality show a team that operates under the same high standards and takes their work seriously. Clients trust organizations that look organized. They feel confident doing business with people who present themselves as capable professionals.`,

    `Your team benefits too. They represent your company with more confidence on LinkedIn, in email signatures and in every client interaction. The investment in their image becomes an investment in how they see themselves as part of your organization.`
  ],

  experienceParagraphs = [

    `Most people dread having their photo taken. Their last experience was probably a high school yearbook session where they were rushed through with no direction, awkward silence, forced smiles, and results that matched. My sessions are conversational and collaborative. I keep people talking, laughing, and engaged so they forget the camera exists. When your team is comfortable, it shows in the final images. Most people tell me afterward they actually enjoyed the experience.`,

    `Standing in front of a camera can feel unnatural. I guide every team member through a tailored process that elicits genuine, confident facial expressions which build trust and credibility. This is a skilled and deliberate process where your people are guided to look their best and not left to figure it out themselves.`,

    `Every image appears on my computer the moment it is captured. Team members see themselves in real time. Lighting, posture and facial expression are refined on the spot. I guide the selection process to ensure consistency across your organization while honoring what makes each team member unique.`,
  
  ],

  steps = [
    { title: "Request", icon: "request", line: "A proposal built around your team" },
    { title: "Schedule", icon: "schedule", line: "Your date is set and details arranged" },
    { title: "Photograph", icon: "photograph", line: "I set up on site and coach every person" },
    { title: "Select", icon: "select", line: "Each person chooses their image before leaving" },
    { title: "Retouch", icon: "retouch", line: "My retoucher finishes every final image" },
    { title: "Deliver", icon: "deliver", line: "You approve the gallery, then download" }
  ],
  expectationsParagraph = `Your team members are not professional models. They don't know what to do with their hands, posture, or facial expressions. My job is to provide clear and specific coaching that eliminates awkwardness and draws out authenticity. The goal is for every team member to see themselves at their best and leave with a skip in their step. I have refined this coaching approach over ${yearsExperience} years photographing corporate teams to help professionals look awesome in photos and walk away having enjoyed the process.`,

  facts = [
    { title: "Tethered Capture", detail: "Instant on-screen feedback" },
    { title: "Advanced Coaching", detail: "Guidance and direction" },
    { title: "Systematic Approach", detail: "Refined for teams" },
    { title: "Instant Review", detail: "Your choice of images" },
    { title: "Consistent Headshots", detail: "Across your whole team" },
    { title: "Studio Lighting", detail: "Brought to your office" },
    { title: "Unhurried Sessions", detail: "Nothing is rushed" },
    { title: "Professional Retouching", detail: "Available on every image" }
  ],
  logistics = [
    { label: "Time Per Person", value: "Approx. 5 - 15 minutes" },
    { label: "Space Required", value: "15 x 15 feet minimum" },
    { label: "Equipment Provided", value: "Full studio setup included" },
    { label: "Selection Process", value: "Real-time review with guidance" },
    { label: "Service Area", value: "PA, MD, DE, NY, NJ" }
  ],

  faqs = [                                                                  
      {                                                                       
        question: "How does scheduling work for office headshot sessions?",                                               
        answer: `I arrange the date and terms with your point of contact in advance. On the day of the session, I arrive about an hour early to set up equipment, ensure everything is in good working order, and confirm I am ready to work with team members. Team members can be scheduled in increments that work for your company, whether that is every 5 minutes, 15 minutes, or something else. Scheduling can be handled through my online scheduler, a shared spreadsheet, or internally by your team. I also accommodate a first come first served approach if that works better for your office.
        `                                                   
      },                                                                      
      {                                                                       
        question: "How much time do you spend photographing each team member?",                                               
        answer: `Some people are done in 5 minutes. Others need a bit more time and coaching. I schedule in 5 to 15 minute increments, but rushing does not produce high quality results. Every team member gets the time they need to walk away with an image they are proud of.
        `                                                    
      },                                                                      
      {                                                                       
        question: "What if a team member misses the headshot session?",                                               
        answer: `I am happy to arrange a return trip to photograph anyone who missed the original session. This requires coordination with your point of contact and carries an additional fee. If your team members are willing to travel to my studio in Lancaster, I can photograph them there as well. Either way, the images will match.
        `                                                    
      },
      {
        question: "How much space is needed for an office headshot session?",
        answer: `I require a space that is at least 15 feet by 15 feet with accessible power outlets. Wifi is helpful but not necessary. I am relatively self-contained. I bring all of my own equipment including camera, lights, backgrounds, computer, stands, tripods, and cables. I always clean my work area, and leave it in the same condition I found it.
        `
      }                                                                       
    ]                    






} = Astro.props;

// Service schema
const officeHeadshotsServiceSchema = buildServiceSchema(
  "Office Headshots",
  "Professional On-Location Office Headshot Photography",
  "Professional on-location office headshots for businesses and corporate teams. Richard Waine Photography brings studio-quality headshots directly to your office, delivering consistent, polished results for your entire team.",
  "Richard Waine Photography",
  "Lancaster",
  "PA",
  "+1-717-925-0061",
  ["Pennsylvania", "New York", "New Jersey", "Delaware", "Maryland", "Virginia"]
);

// Review schemas - 3 testimonials
const ericCooleyReview = buildReviewSchema(
  {
    author: "Eric Cooley",
    company: "Havtech",
    rating: "5",
    reviewBody: "We had Richard come in to perform headshots for the business. He took the time with each person to make sure he got the right shot. Literally, the best picture I have ever seen of me. I sent it to my mom and she said 'oh wow, that's you?' So good my own mom didn't recognize me. Thanks for everything Richard!"
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const mackenzieLucasReview = buildReviewSchema(
  {
    author: "Mackenzie Lucas",
    company: "ProAssurance",
    rating: "5",
    reviewBody: "We used Richard Waine for company headshots and we loved him! He worked with our schedule, and was warned that the people who were getting their photos taken disliked the previous photographer and that did not phase him! He was great at communicating and all of the people who worked with him that day loved him. Absolutely will use again."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const danielHagelbergReview = buildReviewSchema(
  {
    author: "Daniel Hagelberg",
    company: "Kaufman Dolowich",
    rating: "5",
    reviewBody: "My firm hired Richard for my headshot and he was excellent. He brought his equipment to our office, and set everything up to get a top quality studio shot. His instructions were easy to follow and the pictures look amazing. He will work with you to get what you want but he also knows what will make the best shot. Would definitely use him again."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

// FAQ schema
const officeHeadshotsFAQSchema = buildFAQSchema(faqs);

// This page's own address, filled in by Astro. The animation script reads it.
const pagePath = Astro.url.pathname.replace(/\/$/, '');

/* The figures at the foot of the hero. They describe the business, so they
   are the same on every service page. */
const spec = [
  { v: String(yearsExperience), l: "YEARS EXPERIENCE" },
  { v: String(reviewCount), l: "5-STAR GOOGLE REVIEWS" },
  { v: "10,000+", l: "HEADSHOTS DELIVERED" },
  { v: "100%", l: "CLIENT SATISFACTION" }
];
---

<MainLayout title={pageTitle} description={metaDescription}>

<!-- Service Schema -->
<script type="application/ld+json" set:html={JSON.stringify(officeHeadshotsServiceSchema)} />

<!-- Review Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(ericCooleyReview)} />
<script type="application/ld+json" set:html={JSON.stringify(mackenzieLucasReview)} />
<script type="application/ld+json" set:html={JSON.stringify(danielHagelbergReview)} />

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(officeHeadshotsFAQSchema)} />

<div class="page" data-page-path={pagePath}>

<ServiceHero
    heroTitle={heroTitle}
    heroTitleAccent={heroTitleAccent}
    heroDescription={heroDescription}
    heroButtonText={heroButtonText}
    heroButtonUrl={heroButtonUrl}
    secondaryButtonText={SecondaryButtonText}
    secondaryButtonUrl={SecondaryButtonUrl}
    heroBg={RW2}
    heroBgAlt="Professional headshot photographer Richard Waine photographing a client in Lancaster PA studio with dual monitor setup displaying professional headshots"
    portraitImage={Chubb}
    portraitAlt="Professional corporate headshot contact sheet grid displaying 34 diverse Chubb insurance company employees in business professional and business casual attire with consistent gray studio background lighting by Richard Waine Photography"
    portraitWidth={800}
    portraitHeight={800}
    callout1={callout1}
    callout2={callout2}
    stats={spec}
    serviceAreaIntro="On-site office headshots across"
    serviceAreas={[
      { label: 'Lancaster', url: '/' },
      { label: 'Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'Greater Baltimore', url: '/baltimore-headshots/' },
      { label: 'Harrisburg and Hershey', url: '/harrisburg-headshots/' },
      { label: 'York and Hanover', url: '/york-headshots/' },
      { label: 'Delaware Businesses', url: '/delaware-headshots/' },
    ]}
/>

<Gallery showButton={false}/>

  <ServicePanels
    headlineLines={panelHeadlineLines}
    headlineAccent={panelHeadlineAccent}
    whyTitle={whyTitle}
    whyParagraphs={whyParagraphs}
    experienceParagraphs={experienceParagraphs}
    steps={steps}
    expectationsParagraph={expectationsParagraph}
    facts={facts}
    logistics={logistics}
  />
  
   <div class="closing-sections">

  <section class="testimonials-section">

    <Testimonials2 title="Office Headshot Reviews" limit={3} filterByNames={["Eric Cooley", "Mackenzie Lucas", "Daniel Hagelberg"]}/>
    
  </section>


    <section class="faq-section" data-reveal>
      <FAQAccordion faqs={faqs}/>
    </section>

  </div>

</div>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
  const page = document.querySelector<HTMLElement>('.page');
  if (!page) return;
  if (window.location.pathname.replace(/\/$/, '') !== page.dataset.pagePath) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = gsap.context(() => {

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 16, duration: 1.4, ease: 'expo.out',
        /* the inline styles come off when the reveal ends, so the
           stylesheet's own transform on the card applies at every width,
           including after a resize */
        clearProps: 'opacity,transform',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true }
      });
    });

    /* The gallery assembles: every frame arrives in a random order rather
       than sweeping left to right, then the wall sits still. Nothing here
       touches Gallery.astro — it targets the markup from this page only. */
    const cells = gsap.utils.toArray<HTMLElement>('#gallery-section .gallery > div');
    if (cells.length) {
      gsap.from(cells, {
        opacity: 0,
        duration: 1.1,
        ease: 'expo.out',
        stagger: { each: 0.03, from: 'random' },
        scrollTrigger: { trigger: '#gallery-section', start: 'top 80%', once: true }
      });
    }


  }, page);

  window.addEventListener('load', () => ScrollTrigger.refresh());
  document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
});
</script>

<script>
import '../scripts/service-page-animations';
</script>

</MainLayout>

<style>
  body {
    background: #08080a;
    color: var(--ltclr);
  }

  /* One vertical rhythm for every section on the page. */
  .page {
    --section-space: clamp(4rem, 9vw, 8rem);
  }

  /* ==========================================
     BASE = PHONE
     Everything outside a media query is the phone layout. Tablet adds
     on at 48em (768px). Desktop adds on at 90em (1440px), the same
     width where ServiceHero switches to its two-column layout.
     ========================================== */

  /* The gallery sits on the page's one content edge, same as .wrapper.
     The shared component adds its own side padding and an inner width
     cap, which stacked three insets on a phone. Both are removed here
     and put back at desktop. */
  :global(div.page #gallery-section) {
    padding-inline: 0;
  }
  :global(#gallery-section .gallery-container) {
    padding-block: var(--section-space);
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  /* The shared gallery picks its columns from its container width, which
     was built for the desktop wrapper. This page sets the columns and
     which frames show at every breakpoint instead. Two-across on phones,
     as on the other service pages. */
  :global(#gallery-section .gallery) {
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--size-3);
  }

  .closing-sections {
    display: grid;
    align-content: center;
    min-height: 100vh;
    gap: var(--section-space);
    padding-block: var(--section-space);
    /* the fixed MENU bar and the chat bubble sit on the bottom of the
       screen, so the page ends with room for them under the last row */
    padding-block-end: calc(var(--section-space) + var(--size-5));
  }


  .testimonials-section {
    padding-block: 0;
  }
 

  /* ---------- the accordion, standing on the page on its own ---------- */

  /* the accordion sits on the page's content edge and runs narrower than
     the rest of the page at desktop, because question rows don't need the full
     content width */
  .faq-section {
    width: calc(100% - var(--size-8));
    max-width: 70rem;
    margin-inline: auto;
  }

  /* FAQAccordion ships with a top margin for the pages that use it with a
     heading above. This page has no heading, so the margin is removed here
     rather than in the shared component. */
  .faq-section :global(.faq-content) {
    margin-block-start: 0;
  }

  /* the questions are bold capitals, so they run 14px on a phone and grow
     back to the component's 16px by desktop */
  .faq-section :global(.question) {
    font-size: var(--fs-clamp-sm);
  }

  /* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
  @media (min-width: 48em) {

    /* four across, eight frames */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--size-3);
    }
    :global(#gallery-section .gallery .image1),
    :global(#gallery-section .gallery .image2),
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4),
    :global(#gallery-section .gallery .image5),
    :global(#gallery-section .gallery .image6),
    :global(#gallery-section .gallery .image7),
    :global(#gallery-section .gallery .image8) {
      display: block;
    }
    :global(#gallery-section .gallery .image9),
    :global(#gallery-section .gallery .image10),
    :global(#gallery-section .gallery .image11),
    :global(#gallery-section .gallery .image12),
    :global(#gallery-section .gallery .image13),
    :global(#gallery-section .gallery .image14),
    :global(#gallery-section .gallery .image15),
    :global(#gallery-section .gallery .image16) {
      display: none;
    }

  }

  /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     The sideways sliding, exactly as before.
     ========================================== */
  @media (min-width: 90em) {

    :global(div.page #gallery-section) {
      padding-inline: var(--size-8);
    }
    :global(#gallery-section .gallery-container) {
      /* width: 80%; */
    }
    /* three across, two rows, the six frames the gallery shows at 1440 */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-column-gap);
    }
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4) {
      display: none;
    }

  }


  

  /* ==========================================
     WIDE DESKTOP - min-width: 106.0625em (1697px)
     The width at which the gallery's container reaches 1025px and its
     full eight-across wall of sixteen frames begins.
     ========================================== */
  @media (min-width: 106.0625em) {

    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(8, 1fr);
    }
    :global(#gallery-section .gallery [class^="image"]) {
      display: block;
    }


    }


</style>
