---
// @ts-nocheck
import MainLayout from "../layouts/MainLayout.astro"
import FAQAccordion from '../components/FAQAccordion.astro';
import Testimonials2 from '../components/Testimonials2.astro';
import Gallery from '../components/Gallery.astro';
import ServiceHero from '../components/service-pages/ServiceHero.astro';
import ServicePanels from '../components/service-pages/ServicePanels.astro';
import { buildServiceSchema, buildReviewSchema, buildFAQSchema } from '../utils/schema';
import { reviewCount, yearsExperience, ALL_TESTIMONIALS } from '../data/testimonials';

import HeroImage from "../assets/images/professions/JamesKennedy - 0006 (horizontal).jpg"
import HeroBg from "../assets/images/blog/RW7 - (16 x 9).jpg"



export interface Props {
  // SEO
  pageTitle?: string;
  metaDescription?: string;

  // Hero Section
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;

  // Blueprint Callouts
  callout1?: string;
  callout2?: string;

  // Button URLs
  heroButtonUrl?: string;

  // Service Panels
  panelHeadlineLines?: string[];
  panelHeadlineAccent?: string;
  whyTitle?: string;
  whyParagraphs?: string[];
  experienceParagraphs?: string[];
  expectationsParagraph?: string;
  facts?: { title: string; detail: string }[];
}

const {
  pageTitle = 'Professional Headshots for Lawyers | Richard Waine Photography',
  metaDescription = 'Headshots for attorneys that make you easy to trust and hard to dismiss. Schedule your headshot session, made for lawyers.',

  heroTitle = 'Lawyer',
  heroTitleAccent = 'Headshots',
  heroDescription = 'Your headshot appears on firm websites and legal directories. Clients need to trust you and feel comfortable talking to you. I create attorney headshots that project authority and competence.',
  heroButtonText = 'GET PRICING',
  SecondaryButtonText = 'SCHEDULE CONSULT',

  callout1 = 'AUTHORITY',
  callout2 = 'COMPETENCE',

  heroButtonUrl = '/rates',
  SecondaryButtonUrl = "https://app.acuityscheduling.com/schedule/f0843291/appointment/11959793/calendar/1133425?appointmentTypeIds[]=11959793",

  // Service Panels (the three sliding panels)
  panelHeadlineLines = ["THE", "ATTORNEY", "HEADSHOT"],
  panelHeadlineAccent = "EXPERIENCE",
  whyTitle = "WHY LAWYERS NEED PROFESSIONAL HEADSHOTS",
  whyParagraphs = [
    `A prospective client sits at a desk late at night, searching for legal counsel during one of the most stressful moments of their life. They open ten browser tabs, only to find identical law degrees, identical bar admissions, and identical lists of practice areas.`,
    `In that moment of uncertainty, credentials alone cannot guide their choice. The client is looking for a human connection, searching for an advocate who will be both empathetic enough to hear their story and formidable enough to protect their interests.`,
    `Your headshot is the exact moment that story begins. It transforms a flat list of qualifications into a real, trusted person, positioning you as the authority they need to call.`
  ],
  experienceParagraphs = [
    `You may not know what to expect from a professional headshot session, and you may not be someone who enjoys having your photo taken.`,
    `Your session is a dedicated, one-on-one experience where every detail is considered and nothing is finished until you are confident in the result. You and every aspect of your session receive the same level of care and attention that thousands of professionals across six states have entrusted with their most important professional asset. They walked in uncertain and walked out transformed, not just by the images, but by how the experience made them feel about themselves.`,
    `The attorneys who have been through this session do not leave wondering whether they made the right choice. They leave knowing they did.`
  ],
  expectationsParagraph = `Your headshot session is a focused, collaborative experience where you are coached and directed to look and feel your absolute best. Every moment is intentional, and every image is made with precision and care.`,
  facts = [
    { title: "Expert Direction", detail: "Precise and personal" },
    { title: "Expression Coaching", detail: "Authentic and natural" },
    { title: "Fully at Ease", detail: "Quickly and genuinely" },
    { title: "Fun and Engaging", detail: "The entire session" },
    { title: "New Confidence", detail: "In yourself and images" },
    { title: "Magazine Quality", detail: "From every session" },
    { title: "Collaborative", detail: "From start to finish" },
    { title: "Dedicated Excellence", detail: "Every single time" }
  ],

  faqs = [
  { question: "Why do lawyers need professional headshots?",
    answer: `Lawyers need a professional headshot because a client choosing an attorney is comparing those with credentials that all look identical. Putting a face to your name gives them something the credentials cannot, which is a sense of their personality, character, and whether they can talk to you about something difficult. A picture that shows how you actually come across is what makes you memorable.` },

  { question: "What should I wear for an attorney headshot?",
    answer: `I recommend bringing a variety of tops rather than a single outfit. Suits and blazers photograph well, and I lean toward recommending solid colors. However, you should bring colors that you prefer and items that love and feel good in. My clients shoot with greater success in clothes they love, and do not be afraid to mix cuts, colors, layers, and textures. More detail is in my guide <a href="/blog/what-to-wear-for-headshots/">what to wear for headshots</a>.` },

  { question: "When should I update my headshot?",
    answer: `I recommend that everyone, attorneys included, update their headshot every one to two years, or sooner when your style, hair, or appearance changes. Making partner, moving to another firm, a merger, or a business development event each put your photograph in front of people who have never seen you, so treat those as triggers of their own. When the picture and the person no longer match, your client's expectation and the reality are out of alignment. I have written about this in <a href="/blog/consistency-in-your-headshot/">consistency in your headshot</a>.` },

  { question: "Where should attorneys be using their headshot?",
    answer: `Use your headshot anywhere a potential client encounters you before you meet in person. Beyond your law firm bio and your own profiles, that means the legal directories clients actually search, including Martindale-Hubbell, Avvo, Super Lawyers, Justia, and your state bar listing. I have written more about <a href="/blog/why-lawyers-need-professional-headshots-enhancing-your-legal-brand/">why lawyers need professional headshots</a>.` },

  { question: "What background is best for attorney headshots?",
    answer: `Solid grey, white, and black all work, and so do hand-painted canvas and textured backgrounds. Legal books as a background confirm you are an attorney, which the reader knew before they clicked on your profile. A plain background is the more contemporary choice, and it puts your expression in front of them without competition or distraction. Every option is covered in <a href="/blog/best-backgrounds-for-professional-headshots/">my guide to headshot backgrounds</a>.` }

]

} = Astro.props;

const lawyerHeadshotsSchema = buildServiceSchema(
  "Lawyer Headshots", "Professional Headshots for Attorneys",
  "Professional headshots for lawyers, attorneys, and law firms. Project authority, competence, and trustworthiness with expert direction and real-time review.",
  "Richard Waine Photography", "Lancaster", "PA", "+1-717-925-0061",
  ["Pennsylvania", "New York", "New Jersey", "Delaware", "Maryland", "Virginia"]);
const lawyerFAQSchema = buildFAQSchema(faqs);

const quoteNames = ["Jacqueline Johansen", "Keith Woody", "Kelly Gooch"];
const quotes = quoteNames
  .map((n) => ALL_TESTIMONIALS.find((t) => t.name === n))
  .filter(Boolean);
const quoteSchemas = quotes.map((q) => buildReviewSchema(
  { author: q.name, company: q.company, rating: String(q.rating), reviewBody: q.review },
  "Richard Waine Photography", "https://richardwainephotography.com"));

// This page's own address, filled in by Astro. The animation script reads it.
const pagePath = Astro.url.pathname.replace(/\/$/, '');

/* The figures at the foot of the hero. They describe the business, so they
   are the same on every service page. */
const spec = [
  { v: String(yearsExperience), l: "YEARS EXPERIENCE" },
  { v: String(reviewCount), l: "5-STAR GOOGLE REVIEWS" },
  { v: "10,000+", l: "HEADSHOTS DELIVERED" },
  { v: "100%", l: "CLIENT SATISFACTION" }
];

---

<MainLayout title={pageTitle} description={metaDescription}>

<!-- Service Schema -->
<script type="application/ld+json" set:html={JSON.stringify(lawyerHeadshotsSchema)} />

<!-- Review Schemas -->
{quoteSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(lawyerFAQSchema)} />

<div class="page" data-page-path={pagePath}>

<ServiceHero
    heroTitle={heroTitle}
    heroTitleAccent={heroTitleAccent}
    heroDescription={heroDescription}
    heroButtonText={heroButtonText}
    heroButtonUrl={heroButtonUrl}
    secondaryButtonText={SecondaryButtonText}
    secondaryButtonUrl={SecondaryButtonUrl}
    heroBg={HeroBg}
    heroBgAlt="Professional headshot photographer Richard Waine photographing a business professional in Lancaster PA studio"
    portraitImage={HeroImage}
    portraitAlt="Professional headshot of attorney in tan blazer over navy dress shirt projecting authority and competence against neutral gray studio background by Richard Waine Photography"
    callout1={callout1}
    callout2={callout2}
    stats={spec}
    serviceAreaIntro="Serving attorneys in"
    serviceAreas={[
      { label: 'Lancaster', url: '/' },
      { label: 'Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'Baltimore', url: '/baltimore-headshots/' },
      { label: 'Harrisburg', url: '/harrisburg-headshots/' },
      { label: 'York', url: '/york-headshots/' },
      { label: 'Delaware', url: '/delaware-headshots/' },
    ]}
/>

<Gallery showButton={false}/>

  <ServicePanels
    headlineLines={panelHeadlineLines}
    headlineAccent={panelHeadlineAccent}
    whyTitle={whyTitle}
    whyParagraphs={whyParagraphs}
    experienceParagraphs={experienceParagraphs}
    expectationsParagraph={expectationsParagraph}
    facts={facts}
  />
  
   <div class="closing-sections">

  <section class="testimonials-section">

    <Testimonials2 title="Lawyer Headshot Reviews" limit={3} filterByNames={["Jacqueline Johansen", "Keith Woody", "Kelly Gooch"]}/>
    
  </section>


    <section class="faq-section" data-reveal>
      <FAQAccordion faqs={faqs}/>
    </section>

  </div>

</div>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
  const page = document.querySelector<HTMLElement>('.page');
  if (!page) return;
  if (window.location.pathname.replace(/\/$/, '') !== page.dataset.pagePath) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = gsap.context(() => {

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 16, duration: 1.4, ease: 'expo.out',
        /* the inline styles come off when the reveal ends, so the
           stylesheet's own transform on the card applies at every width,
           including after a resize */
        clearProps: 'opacity,transform',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true }
      });
    });

    /* The gallery assembles: every frame arrives in a random order rather
       than sweeping left to right, then the wall sits still. Nothing here
       touches Gallery.astro — it targets the markup from this page only. */
    const cells = gsap.utils.toArray<HTMLElement>('#gallery-section .gallery > div');
    if (cells.length) {
      gsap.from(cells, {
        opacity: 0,
        duration: 1.1,
        ease: 'expo.out',
        stagger: { each: 0.03, from: 'random' },
        scrollTrigger: { trigger: '#gallery-section', start: 'top 80%', once: true }
      });
    }


  }, page);

  window.addEventListener('load', () => ScrollTrigger.refresh());
  document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
});
</script>

<script>
import '../scripts/service-page-animations';
</script>

</MainLayout>

<style>
  body {
    background: #08080a;
    color: var(--ltclr);
  }

  /* One vertical rhythm for every section on the page. */
  .page {
    --section-space: clamp(4rem, 9vw, 8rem);
  }

  /* ==========================================
     BASE = PHONE
     Everything outside a media query is the phone layout. Tablet adds
     on at 48em (768px). Desktop adds on at 90em (1440px), the same
     width where ServiceHero switches to its two-column layout.
     ========================================== */

  /* The gallery sits on the page's one content edge, same as .wrapper.
     The shared component adds its own side padding and an inner width
     cap, which stacked three insets on a phone. Both are removed here
     and put back at desktop. */
  :global(div.page #gallery-section) {
    padding-inline: 0;
  }
  :global(#gallery-section .gallery-container) {
    padding-block: var(--section-space);
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  /* The shared gallery picks its columns from its container width, which
     was built for the desktop wrapper. This page sets the columns and
     which frames show at every breakpoint instead. Two-across on phones,
     as on the other service pages. */
  :global(#gallery-section .gallery) {
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--size-3);
  }

  .closing-sections {
    display: grid;
    align-content: center;
    min-height: 100vh;
    gap: var(--section-space);
    padding-block: var(--section-space);
    /* the fixed MENU bar and the chat bubble sit on the bottom of the
       screen, so the page ends with room for them under the last row */
    padding-block-end: calc(var(--section-space) + var(--size-5));
  }


  .testimonials-section {
    padding-block: 0;
  }
 

  /* ---------- the accordion, standing on the page on its own ---------- */

  /* the accordion sits on the page's content edge and runs narrower than
     the rest of the page at desktop, because question rows don't need the full
     content width */
  .faq-section {
    width: calc(100% - var(--size-8));
    max-width: 70rem;
    margin-inline: auto;
  }

  /* FAQAccordion ships with a top margin for the pages that use it with a
     heading above. This page has no heading, so the margin is removed here
     rather than in the shared component. */
  .faq-section :global(.faq-content) {
    margin-block-start: 0;
  }

  /* the questions are bold capitals, so they run 14px on a phone and grow
     back to the component's 16px by desktop */
  .faq-section :global(.question) {
    font-size: var(--fs-clamp-sm);
  }

  /* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
  @media (min-width: 48em) {

    /* four across, eight frames */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--size-3);
    }
    :global(#gallery-section .gallery .image1),
    :global(#gallery-section .gallery .image2),
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4),
    :global(#gallery-section .gallery .image5),
    :global(#gallery-section .gallery .image6),
    :global(#gallery-section .gallery .image7),
    :global(#gallery-section .gallery .image8) {
      display: block;
    }
    :global(#gallery-section .gallery .image9),
    :global(#gallery-section .gallery .image10),
    :global(#gallery-section .gallery .image11),
    :global(#gallery-section .gallery .image12),
    :global(#gallery-section .gallery .image13),
    :global(#gallery-section .gallery .image14),
    :global(#gallery-section .gallery .image15),
    :global(#gallery-section .gallery .image16) {
      display: none;
    }

  }

  /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     The sideways sliding, exactly as before.
     ========================================== */
  @media (min-width: 90em) {

    :global(div.page #gallery-section) {
      padding-inline: var(--size-8);
    }
    :global(#gallery-section .gallery-container) {
      /* width: 80%; */
    }
    /* three across, two rows, the six frames the gallery shows at 1440 */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-column-gap);
    }
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4) {
      display: none;
    }

  }


  

  /* ==========================================
     WIDE DESKTOP - min-width: 106.0625em (1697px)
     The width at which the gallery's container reaches 1025px and its
     full eight-across wall of sixteen frames begins.
     ========================================== */
  @media (min-width: 106.0625em) {

    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(8, 1fr);
    }
    :global(#gallery-section .gallery [class^="image"]) {
      display: block;
    }


    }


</style>
