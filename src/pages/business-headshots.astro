---
// @ts-nocheck
import MainLayout from "../layouts/MainLayout.astro"
import Testimonials from '../components/Testimonials.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Gallery from '../components/Gallery.astro';
import ServiceHero from '../components/service-pages/ServiceHero.astro';
import PillarCards from '../components/service-pages/PillarCards.astro';
import SystemRow from '../components/service-pages/SystemRow.astro';
import { buildServiceSchema, buildReviewSchema, buildFAQSchema } from '../utils/schema';
import { reviewCount, yearsExperience } from '../data/testimonials';

import WilliamAdote from "../assets/images/features/Headshot_20240919_William Adote_Richard Waine_Lancaster_PA_0023 (horizontal) - compressed.jpg"
import RW1 from "../assets/images/blog/RW_FINAL_V1_Still005.jpg"
import RW2 from "../assets/images/blog/RW7 - (16 x 9).jpg"
import RW11 from "../assets/images/blog/RW11 - (horizontal).jpg"
import EthanHaymovitz from "../assets/images/business-headshots/Ethan Haymovitz - 0135 (horizontal).jpg"


export interface Props {
  // SEO
  pageTitle?: string;
  metaDescription?: string;

  // Hero Section
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;

  // Blueprint Callouts
  callout1?: string;
  callout2?: string;

  // Pillar Cards
  pillar1Num?: string;
  pillar1Title?: string;
  pillar1Description?: string;

  pillar2Num?: string;
  pillar2Title?: string;
  pillar2Description?: string;

  pillar3Num?: string;
  pillar3Title?: string;
  pillar3Description?: string;

  // System Section Row 1
  systemRow1Title?: string;
  systemRow1Description?: string;
  methodItem1?: string;
  methodItem2?: string;
  methodItem3?: string;

  // System Section Row 2
  systemRow2Title?: string;
  systemRow2Description?: string;

  // Footer
  footerTitle?: string;
  footerDescription?: string;
  footerButtonText?: string;

  // Button URLs
  heroButtonUrl?: string;
  systemRow2ButtonText?: string;
  systemRow2ButtonUrl?: string;
  footerButtonUrl?: string;
}

const {
  pageTitle = 'Business Headshots and Corporate Headshots | Richard Waine Photography',
  metaDescription = 'Business headshots for executives, entrepreneurs, and corporate professionals. Build trust and credibility with expert coaching, real-time review, and strategic image selection',

  heroTitle = 'Business',
  heroTitleAccent = 'Headshots',
  heroDescription = 'A corporate headshot isn\'t just a picture. It is a data point in your client\'s decision-making process. I create headshot images that build trust and command attention.',
  heroButtonText = 'GET PRICING',
  SecondaryButtonText = 'SCHEDULE CONSULT',

  callout1 = 'CONFIDENCE',
  callout2 = 'APPROACHABILITY',

  pillar1Num = 'THE SCIENCE',
  pillar1Title = 'Expression Direction',
  pillar1Description = "I don't leave your expression to chance. Using a specific coaching sequence, I direct your facial muscles to create genuine expressions that make viewers trust you instantly.",

  pillar2Num = 'THE PROCESS',
  pillar2Title = 'Real-Time Review',
  pillar2Description = "You’ll never wonder how you’re doing. I work tethered to computer systems for instant feedback, allowing us to adjust lighting and posture in the moment until the image is perfect.",

  pillar3Num = 'THE RESULT',
  pillar3Title = 'Strategic Selection',
  pillar3Description = 'We review headshots through the lens of human perception, ensuring your final images project confidence and credibility. Your selected images are retouched and then delivered to you digitally, ready to use on your website, your LinkedIn profile, and your professional bios.',




  systemRow1Title = 'Why Your Business Headshot Matters',
  systemRow1Description = `A business headshot, also called a corporate headshot, is a professional photograph of the head and shoulders, carefully executed to capture an image that reflects professionalism, personality, and authenticity, conveying who you are in a clear, confident, and approachable manner to establish credibility and shape your personal brand.
  
  Your business headshot shows up everywhere potential clients look for you. It appears on your website, email signature, industry directories, speaking bios, marketing materials, and proposals. That image shapes whether people see you as credible and professional. <a href="https://www.psychologicalscience.org/observer/how-many-seconds-to-a-first-impression">Research from Princeton University</a> shows people form judgments about trustworthiness and competence in just 100 milliseconds of seeing a face. A solid corporate headshot tells them you take your work seriously.
  
  An amateur photo or outdated image undermines everything else you do well in your business. Your headshot should match the quality of work you deliver and the clients you serve. If you invest in your expertise, your systems, and your reputation, your corporate headshot deserves the same attention.
  `,
  methodItem1 = 'Your reputation deserves a headshot to match',
  methodItem2 = 'People do business with those they know, like, and trust',
  methodItem3 = "A high-quality corporate headshot signals leadership and intelligence",
  methodItem4 = 'A strong headshot influences how you come across professionally',


  systemRow2Title = 'System of Direction',
  systemRow2Description = `I don't expect you to know what to do with your hands, your chin, or your eyes. My job is to give you clear, actionable cues that result in a natural, powerful presence. My directions are designed to eliminate camera anxiety and move you into a state of natural confidence.  Posture and head position directly affect how authoritative you appear. Slight, nuanced adjustments make the difference between looking uncertain and looking like someone people want to do business with. I have refined this system of direction over ${yearsExperience} years working with executives, entrepreneurs, and corporate professionals who needed to project confidence and credibility. That work is reflected in more than ${reviewCount} five-star Google <a href="/reviews/">reviews</a>.`,
  methodItem5 = 'Tethered capture for instant feedback',
  methodItem6 = 'Expert coaching and direction',
  methodItem7 = 'A systematic approach unlike typical photographers',
  methodItem8 = 'Instant review and choice of images',
  

  systemRow3Title = 'The Experience',
  systemRow3Description = "Professional headshot sessions have a reputation for being stiff and awkward. That's not what happens here. My sessions are conversational and dynamic. The best moments and often the best expressions happen when you're genuinely enjoying yourself. Clients regularly comment on how much more fun the experience was than they expected.",
  methodItem9 = 'Session preparation guide provided at time of scheduling',
  methodItem10 = 'Wardrobe consultation based on purpose and color psychology',
  methodItem11 = 'Professional lighting that defines your best features',
  methodItem12 = "The dismantling of the 'I am not photogenic' narrative ",


  footerTitle = 'Ready to elevate your brand?',
  footerDescription = 'Stop settling for "good enough" headshots. Invest in your digital handshake.',
  footerButtonText = 'GET PRICING',

  heroButtonUrl = '/rates',
  SecondaryButtonUrl = "https://app.acuityscheduling.com/schedule/f0843291/appointment/11959793/calendar/1133425?appointmentTypeIds[]=11959793",
  systemRow2ButtonText = 'GET PRICING',
  systemRow2ButtonUrl = '/rates',
  footerButtonUrl = '/rates',

  faqs = [                                                                  
      {                                                                       
        question: "What should I do if I’m not photogenic and hate being on camera?",                                               
        answer: `Photogenic is a bullshit, made up word. It is a term people use when they have never seen a photo of themselves they actually like. It suggests the responsibility to look good is on you. It is not.
        
        The onus of a great headshot is squarely on the photographer. Most of us hate being on camera because we have a complicated relationship with our own faces. We see flaws in the mirror that no one else sees or cares about. If you have had bad experiences in the past, it is because the photographer failed to provide the coaching and direction needed to make you feel at ease.
        
        We are not just taking a picture. We are creating a <a href="/blog/what-is-a-professional-headshot/">professional headshot</a> that makes you look confident, competent, and trustworthy.`                                                   
      },                                                                      
      {                                                                       
        question: "What is the best color to wear for a business headshot session?",                                               
        answer: `The best colors for a headshot session depend on the person, the purpose, and the application. I usually default to standard choices like white, grey, black, and navy, but I also recommend bringing a color palette you love.

        The most important thing is to avoid busy patterns and attention grabbing clothing. These elements compete with what matters most, which is your facial expression and the message you are communicating. Simplicity is always best.

        I suggest bringing 3 to 5 options that are cleaned and pressed. Only bring clothes you absolutely love because you will not photograph well in something that makes you feel uncomfortable.
        `                                                    
      },                                                                      
      {                                                                       
        question: "How do I choose the right expression for my brand?",                                               
        answer: `Choosing an expression is about how you show up in the world and how you want to be perceived. There is no universal expression that works for every scenario. Headshot images serve their desired purpose. 

        People want to look confident, approachable, competent and trustworthy. These characteristics typically mirror what my clients are looking for. As a starting point, I always recommend aiming for poise. 

        I cannot tell you that a headshot with a specific facial expression has a place in your universe. However, I can tell you if that image will help or hurt your messaging. When humans have an incredibly sensitive bullshit meter, it’s imperative that you project authenticity. 

        “Trust me” sounds incredibly cliché. But, if you trust me and trust the process, you’ll end up with awesome headshots with incredibly impactful facial expressions!
        `                                                    
      },
      {
        question: "How much time will my session take?",
        answer: `Your headshot session will take as much time as necessary. I don't set arbitrary time limits on my sessions because we work until we have the images you need. I block off three hours for every session to ensure we have a sufficient window, whether we use all of it or not. I recommend allowing at least two hours in your own schedule. While I can accommodate a shorter timeframe, having that buffer ensures we never feel rushed.

        Some clients are in and out in minutes; others take longer to find their stride. In my experience, very few people ever exceed that three-hour mark. While it may sound like a significant block of time, the process is engaging, enjoyable, and the time tends to fly by.
        `
      }                                                                       
    ]                    






} = Astro.props;

// Service schema
const businessHeadshotsServiceSchema = buildServiceSchema(
  "Business Headshots",
  "Professional Business Headshot Photography",
  "Professional business headshots for executives, entrepreneurs, and corporate professionals. High-quality images that enhance your professional presence and brand.",
  "Richard Waine Photography",
  "Lancaster",
  "PA",
  "+1-717-925-0061",
  ["Pennsylvania", "New York", "New Jersey", "Delaware", "Maryland", "Virginia"]
);

// Review schemas - 3 testimonials
const jacquelineJohansenReview = buildReviewSchema(
  {
    author: "Jacqueline Johansen",
    company: "DeepJudge",
    rating: "5",
    reviewBody: "Richard is an expert in human expression. He makes you feel at ease, then draws out the version of you that's authentic and compelling. The resulting headshots work because they feel right. Effortless, but entirely intentional. I have never liked a picture of me so much!"
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const keithWoodyReview = buildReviewSchema(
  {
    author: "Keith Woody",
    company: "Fulton Bank",
    rating: "5",
    reviewBody: "I had no idea, how amazing this experience would turn out to be. The quality of what is being provided and experienced way surpassed my expectations. As a Sourcing and Procurement executive of over 25 years, I highly recommend Richard for your corporate head shot needs."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const kellyGoochReview = buildReviewSchema(
  {
    author: "Kelly Gooch",
    company: "Ultimus Fund Solutions",
    rating: "5",
    reviewBody: "Richard was intentional in understanding my needs and asking questions to understand what type of look was needed. He was organized, helpful, and inquisitive, making the experience enjoyable. The end product was a direct result of his experience and coaching."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

// FAQ schema
const businessHeadshotsFAQSchema = buildFAQSchema(faqs);

// This page's own address, filled in by Astro. The animation script reads it.
const pagePath = Astro.url.pathname.replace(/\/$/, '');

/* The figures at the foot of the hero. They describe the business, so they
   are the same on every service page. */
const spec = [
  { v: String(yearsExperience), l: "YEARS EXPERIENCE" },
  { v: String(reviewCount), l: "5-STAR GOOGLE REVIEWS" },
  { v: "10,000+", l: "HEADSHOTS DELIVERED" },
  { v: "100%", l: "CLIENT SATISFACTION" }
];
---




<MainLayout title={pageTitle} description={metaDescription}>

<!-- Service Schema -->
<script type="application/ld+json" set:html={JSON.stringify(businessHeadshotsServiceSchema)} />

<!-- Review Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(jacquelineJohansenReview)} />
<script type="application/ld+json" set:html={JSON.stringify(keithWoodyReview)} />
<script type="application/ld+json" set:html={JSON.stringify(kellyGoochReview)} />

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(businessHeadshotsFAQSchema)} />

<ServiceHero
    heroTitle={heroTitle}
    heroTitleAccent={heroTitleAccent}
    heroDescription={heroDescription}
    heroButtonText={heroButtonText}
    heroButtonUrl={heroButtonUrl}
    secondaryButtonText={SecondaryButtonText}
    secondaryButtonUrl={SecondaryButtonUrl}
    heroBg={RW2}
    heroBgAlt="Professional headshot photographer Richard Waine photographing a business professional in Lancaster PA studio with dual monitor setup displaying corporate headshots"
    portraitImage={WilliamAdote}
    portraitAlt="Professional business headshot of African-American man with short hair and goatee wearing navy blue suit with light blue patterned tie on white studio background by Richard Waine Photography"
    callout1={callout1}
    callout2={callout2}
    stats={spec}
    serviceAreaIntro="Serving professionals in"
    serviceAreas={[
      { label: 'Lancaster', url: '/' },
      { label: 'Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'the Baltimore metro', url: '/baltimore-headshots/' },
      { label: 'Greater Harrisburg', url: '/harrisburg-headshots/' },
      { label: 'York County', url: '/york-headshots/' },
      { label: 'Delaware', url: '/delaware-headshots/' },
    ]}
/>

<Gallery showButton={false}/>

<PillarCards
    pillar1Num={pillar1Num}
    pillar1Title={pillar1Title}
    pillar1Description={pillar1Description}
    pillar2Num={pillar2Num}
    pillar2Title={pillar2Title}
    pillar2Description={pillar2Description}
    pillar3Num={pillar3Num}
    pillar3Title={pillar3Title}
    pillar3Description={pillar3Description}
/>

<section class="system-section" data-page-path={pagePath}>

<SystemRow
    reverse={true}
    title={systemRow1Title}
    description={systemRow1Description}
    methodItems={[methodItem1, methodItem2, methodItem3, methodItem4]}
    image={EthanHaymovitz}
    imageAlt="Professional business headshot of psychotherapist with beard and glasses in blue blazer over white shirt, friendly smile and confident facial expression against black studio background, headshot made by Richard Waine in Lancaster Pennsylvania"
/>

<SystemRow
    title={systemRow2Title}
    description={systemRow2Description}
    methodItems={[methodItem5, methodItem6, methodItem7, methodItem8]}
    image={RW1}
    imageAlt="Business headshot photography session showing blonde woman in tan plaid blazer surrounded by professional photo studio lighting equipment in Lancaster PA studio by Richard Waine Photography"
/>

<SystemRow
    reverse={true}
    title={systemRow3Title}
    description={systemRow3Description}
    methodItems={[methodItem9, methodItem10, methodItem11, methodItem12]}
    image={RW11}
    imageAlt="Behind-the-scenes professional business headshot photography session showing woman in black cardigan and pink lace top positioned between Westcott lighting panels and camera by Richard Waine Photography"
/>
</section>

<section id="testimonials">
  <Testimonials limit={3} filterByNames={["Jacqueline Johansen", "Keith Woody", "Kelly Gooch"]}/>
</section>

<section class="FAQs">

  <FAQAccordion faqs={faqs}/>

</section>


<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
const pagePath = document.querySelector<HTMLElement>('[data-page-path]')?.dataset.pagePath;
if (window.location.pathname.replace(/\/$/, '') !== pagePath) return;
let mm = gsap.matchMedia();

  mm.add("(min-width: 48em)", () => {
  // Animate pillar cards on scroll
  gsap.utils.toArray('.pillar-card').forEach((card: any, index) => {
    gsap.from(card, {
      opacity: 0,
      y: 60,
      rotateX: -15,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: card,
        start: "top 80%",
        end: "top 50%",
        scrub: 1
      }
    });
  });

  // Animate system content rows
  gsap.utils.toArray('.system-content').forEach((content: any) => {
    gsap.to(content, {
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "power2.out",
      scrollTrigger: {
        trigger: content,
        start: "top 90%",
        end: "top 40%",
        scrub: 1
      }
    });
  });

  // Parallax effect on system images
  gsap.utils.toArray('.system-image').forEach((image: any) => {
    gsap.to(image, {
      y: -50,
      ease: "none",
      scrollTrigger: {
        trigger: image,
        start: "top bottom",
        end: "bottom top",
        scrub: true
      }
    });
  });

  // Blueprint callouts animation
  gsap.from('.callout', {
    opacity: 0,
    x: -30,
    stagger: 0.3,
    duration: 1,
    ease: "power2.out",
    scrollTrigger: {
      trigger: '.blueprint-box',
      start: "top 70%"
    }
  });

  // Hero text animation
  gsap.from('.hero-text > *', {
    opacity: 0,
    y: 30,
    stagger: 0.2,
    duration: 1,
    ease: "power2.out"
  });

  // Blueprint box 3D rotation on scroll
  gsap.to('.blueprint-box', {
    rotateY: 5,
    rotateX: 2,
    ease: "none",
    scrollTrigger: {
      trigger: '.hero',
      start: "top top",
      end: "bottom top",
      scrub: true
    }
  });

  return () => {
    //optional cleanup code here
    };
  });
});
</script>


</MainLayout>


<style>
  :root {
  --bg: #050505;
  --card: #111111;
  --text:var(--ltclr);
  --text-dim:var(--ltclr);
 
}



body {
  background: var(--bg);
  color: var(--text);
  line-height:var(--line-height-relaxed);
  width:100%;
  margin-inline:auto;
  padding:0;
  min-height:calc(100vh + var(--header-height));

a{
    color:blue;
}

}


/* The "System" Section - Staggered */
.system-section {
  margin-block:var(--size-825);
  position: relative;
  width:calc(100% - var(--size-7));
  margin-inline:auto;
}


#testimonials{

    height: auto;                                                                
    display: grid;                                                               
    place-items: center;                                                         
    background: #080808; 

      > * > * > * .card-testimonial{
    margin-inline:0;
      }

      > * > * > * > * .testimonial-content{
        padding-inline:0;
        margin-inline:0;
      }

}

.FAQs {
  
  width:calc(100% - var(--size-4));
  margin-inline:auto;
  margin-bottom:var(--size-10);
 
}


/* ==========================================                                   
     TABLET - min-width: 48em (768px)                                             
     ========================================== */                                
        @media (min-width: 48em) {

          .FAQs{
            width:80%;
          }



  }
 /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     ========================================== */
  @media (min-width: 90em) {

        .FAQs{
            width:50%;
          }


  }

  /*change padding and max width of gallery beneath header */
:global(#gallery-section .gallery-container) {
    padding-top: var(--size-825);
    /* max-width:105rem; */
    max-width:85%;
    margin-inline:auto;
  }
  
/* This page only: gallery squares two-across on phones so they sit smaller than the horizontal hero image */
@media (max-width: 47.9375em) {
  :global(#gallery-section .gallery) {
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--size-3);
  }
}

</style>