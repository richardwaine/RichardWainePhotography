---
// @ts-nocheck
import MainLayout from "../layouts/MainLayout.astro"
import FAQAccordion from '../components/FAQAccordion.astro';
import Testimonials2 from '../components/Testimonials2.astro';
import Gallery from '../components/Gallery.astro';
import ServiceHero from '../components/service-pages/ServiceHero.astro';
import ServicePanels from '../components/service-pages/ServicePanels.astro';
import { buildServiceSchema, buildReviewSchema, buildFAQSchema } from '../utils/schema';
import { reviewCount, yearsExperience } from '../data/testimonials';

import WilliamAdote from "../assets/images/features/Headshot_20240919_William Adote_Richard Waine_Lancaster_PA_0023 (horizontal) - compressed.jpg"
import RW2 from "../assets/images/blog/RW7 - (16 x 9).jpg"


export interface Props {
  // SEO
  pageTitle?: string;
  metaDescription?: string;

  // Hero Section
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;

  // Blueprint Callouts
  callout1?: string;
  callout2?: string;

  // Button URLs
  heroButtonUrl?: string;

  // Service Panels
  panelHeadlineLines?: string[];
  panelHeadlineAccent?: string;
  whyTitle?: string;
  whyParagraphs?: string[];
  experienceParagraphs?: string[];
  expectationsParagraph?: string;
  facts?: { title: string; detail: string }[];
}

const {
  pageTitle = 'Business Headshots and Corporate Headshots | Richard Waine Photography',
  metaDescription = 'Business headshots for executives, entrepreneurs, and corporate professionals. Build trust and credibility with expert coaching, real-time review, and strategic image selection',

  heroTitle = 'Business',
  heroTitleAccent = 'Headshots',
  heroDescription = 'A corporate headshot isn\'t just a picture. It is a data point in your client\'s decision-making process. I create business, corporate and executive headshots that build trust and command attention.',
  heroButtonText = 'GET PRICING',
  SecondaryButtonText = 'SCHEDULE CONSULT',

  callout1 = 'CONFIDENCE',
  callout2 = 'APPROACHABILITY',

  heroButtonUrl = '/rates',
  SecondaryButtonUrl = "https://app.acuityscheduling.com/schedule/f0843291/appointment/11959793/calendar/1133425?appointmentTypeIds[]=11959793",

  // Service Panels (the three sliding panels)
  panelHeadlineLines = ["THE BUSINESS", "HEADSHOT"],
  panelHeadlineAccent = "EXPERIENCE",
  whyTitle = "WHY PROFESSIONALS NEED CORPORATE HEADSHOTS",
  whyParagraphs = [
    `A business headshot, also called a corporate headshot, is a professional photograph of the head and shoulders that reflects professionalism, personality, and authenticity.`,
    `Your business headshot appears on your website, email signature, industry directories, speaking bios, marketing materials, and proposals. That image shapes whether people see you as credible and professional. <a href="https://www.psychologicalscience.org/observer/how-many-seconds-to-a-first-impression">Research from Princeton University</a> shows people form judgments about trustworthiness and competence in just 100 milliseconds of seeing a face. A solid corporate headshot tells them you take your work seriously.`,
    `An amateur photo or outdated image undermines everything else you do well in your business. Your headshot should match the quality of work you deliver and the clients you serve. If you invest in your expertise, your systems, and your reputation, your corporate headshot deserves the same attention.`
  ],
  experienceParagraphs = [
    `Professional headshot sessions have a reputation for being stiff and awkward. That's not what happens here.`,
    `Your session has no time limit, so nothing is rushed and you never have to perform on cue. My sessions are conversational and dynamic. The best moments and often the best expressions happen when you're genuinely enjoying yourself. I don't leave your expression to chance. Using a specific coaching sequence, I direct your facial muscles to create genuine expressions that make viewers trust you instantly.`,
    `You’ll never wonder how you’re doing. I work tethered to computer systems for instant feedback. Clients regularly comment on how much more fun the experience was than they expected.`
  ],
  expectationsParagraph = `Most headshots fail because the person in front of the camera is left to guess. You will never guess here. The System of Direction is a method refined over ${yearsExperience} years specializing in making headshots for executives, entrepreneurs, and corporate professionals. Every angle and every expression gets deliberate direction, you see each image the moment it is made, and nothing is finished until it earns your yes. That work is reflected in more than ${reviewCount} five-star Google <a href="/reviews/">reviews</a>.`,
  facts = [
    { title: "Expert Direction", detail: "Precise and personal" },
    { title: "Expression Coaching", detail: "Authentic and natural" },
    { title: "Fully at Ease", detail: "Quickly and genuinely" },
    { title: "Professional Retouching", detail: "Included on every image" },
    { title: "New Confidence", detail: "In yourself and images" },
    { title: "Magazine Quality", detail: "From every session" },
    { title: "Collaborative", detail: "From start to finish" },
    { title: "Dedicated Excellence", detail: "Every single time" }
  ],

  faqs = [
      {
        question: "What should I do if I’m not photogenic and hate being on camera?",                                               
        answer: `Photogenic is a bullshit, made up word. It is a term people use when they have never seen a photo of themselves they actually like. It suggests the responsibility to look good is on you. It is not.
        
        The onus of a great headshot is squarely on the photographer. Most of us hate being on camera because we have a complicated relationship with our own faces. We see flaws in the mirror that no one else sees or cares about. If you have had bad experiences in the past, it is because the photographer failed to provide the coaching and direction needed to make you feel at ease.
        
        We are not just taking a picture. We are creating a <a href="/blog/what-is-a-professional-headshot/">professional headshot</a> that makes you look confident, competent, and trustworthy.`                                                   
      },                                                                      
      {                                                                       
        question: "What is the best color to wear for a business headshot session?",                                               
        answer: `The <a href="/blog/best-colors-for-professional-headshots/">best colors for a headshot session</a> depend on the person, the purpose, and the application. I usually default to standard choices like white, grey, black, and navy, but I also recommend bringing a color palette you love.

        The most important thing is to avoid busy patterns and attention grabbing clothing. These elements compete with what matters most, which is your facial expression and the message you are communicating. Simplicity is always best.

        I suggest bringing 3 to 5 options that are cleaned and pressed. Only bring clothes you absolutely love because you will not photograph well in something that makes you feel uncomfortable.
        `                                                    
      },                                                                      
      {                                                                       
        question: "How do I choose the right expression for my brand?",                                               
        answer: `Choosing an expression is about how you show up in the world and how you want to be perceived. There is no universal expression that works for every scenario. Headshot images serve their desired purpose. 

        People want to look confident, approachable, competent and trustworthy. These characteristics typically mirror what my clients are looking for. As a starting point, I always recommend aiming for poise. 

        I cannot tell you that a headshot with a specific facial expression has a place in your universe. However, I can tell you if that image will help or hurt your messaging. When humans have an incredibly sensitive bullshit meter, it’s imperative that you project authenticity. 

        “Trust me” sounds incredibly cliché. But, if you trust me and trust the process, you’ll end up with awesome headshots with incredibly impactful facial expressions!
        `                                                    
      },
      {
        question: "How much time will my session take?",
        answer: `Your headshot session will take as much time as necessary. I don't set arbitrary time limits on my sessions because we work until we have the images you need. I block off three hours for every session to ensure we have a sufficient window, whether we use all of it or not. I recommend allowing at least two hours in your own schedule. While I can accommodate a shorter timeframe, having that buffer ensures we never feel rushed.

        Some clients find their stride quickly, and others take longer. If you have a hard stop, please tell me and I'll work around your schedule. In my experience, very few people ever exceed that three-hour mark. While it may sound like a significant block of time, the process is engaging, enjoyable, and the time tends to fly by.
        `
      }                                                                       
    ]                    

} = Astro.props;

// Service schema
const businessHeadshotsServiceSchema = buildServiceSchema(
  "Business Headshots",
  "Professional Business Headshot Photography",
  "Professional business headshots for executives, entrepreneurs, and corporate professionals. High-quality images that enhance your professional presence and brand.",
  "Richard Waine Photography",
  "Lancaster",
  "PA",
  "+1-717-925-0061",
  ["Pennsylvania", "New York", "New Jersey", "Delaware", "Maryland", "Virginia"]
);

// Review schemas - 3 testimonials
const chrisPatilleReview = buildReviewSchema(
  {
    author: "Chris Patille",
    company: "",
    rating: "5",
    reviewBody: "From the minute i met Richard Waine i knew their was something special about this guy. He found my need for a new headshot and produced incredible results. I have never felt more confident in myself and my brand until after posting the headshots he took of me. Thanks again Richard you were awesome to work with."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const emilyMainquistReview = buildReviewSchema(
  {
    author: "Emily Mainquist",
    company: "",
    rating: "5",
    reviewBody: "Richard is a fantastic photographer! He is so helpful in making sure you get the perfect photo! He coaches and shows you the pictures as he is taking them so you can learn and adjust to get the shot. He is a perfectionist and it shows in his work. I definitely recommend Richard Waine Photography. He definitely has a customer for life in me and my family."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const ramiroCastilloReview = buildReviewSchema(
  {
    author: "Ramiro Castillo",
    company: "",
    rating: "5",
    reviewBody: "Had a Blast working with Richard. He made me feel comfortable and good in front of the camera. If you are looking for a professional headshot RWP is definitely the place to go. Richard is a professional and he does an outstanding job. If I could give him a 10 star review I would."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

// FAQ schema
const businessHeadshotsFAQSchema = buildFAQSchema(faqs);

// This page's own address, filled in by Astro. The animation script reads it.
const pagePath = Astro.url.pathname.replace(/\/$/, '');

/* The figures at the foot of the hero. They describe the business, so they
   are the same on every service page. */
const spec = [
  { v: String(yearsExperience), l: "YEARS EXPERIENCE" },
  { v: String(reviewCount), l: "5-STAR GOOGLE REVIEWS" },
  { v: "10,000+", l: "HEADSHOTS DELIVERED" },
  { v: "100%", l: "CLIENT SATISFACTION" }
];

---

<MainLayout title={pageTitle} description={metaDescription}>

<!-- Service Schema -->
<script type="application/ld+json" set:html={JSON.stringify(businessHeadshotsServiceSchema)} />

<!-- Review Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(chrisPatilleReview)} />
<script type="application/ld+json" set:html={JSON.stringify(emilyMainquistReview)} />
<script type="application/ld+json" set:html={JSON.stringify(ramiroCastilloReview)} />

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(businessHeadshotsFAQSchema)} />

<div class="page" data-page-path={pagePath}>

<ServiceHero
    heroTitle={heroTitle}
    heroTitleAccent={heroTitleAccent}
    heroDescription={heroDescription}
    heroButtonText={heroButtonText}
    heroButtonUrl={heroButtonUrl}
    secondaryButtonText={SecondaryButtonText}
    secondaryButtonUrl={SecondaryButtonUrl}
    heroBg={RW2}
    heroBgAlt="Professional headshot photographer Richard Waine photographing a business professional in Lancaster PA studio with dual monitor setup displaying corporate headshots"
    portraitImage={WilliamAdote}
    portraitAlt="Professional business headshot of African-American man with short hair and goatee wearing navy blue suit with light blue patterned tie on white studio background by Richard Waine Photography"
    callout1={callout1}
    callout2={callout2}
    stats={spec}
    serviceAreaIntro="Serving professionals in"
    serviceAreas={[
      { label: 'Lancaster', url: '/' },
      { label: 'Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'the Baltimore metro', url: '/baltimore-headshots/' },
      { label: 'Greater Harrisburg', url: '/harrisburg-headshots/' },
      { label: 'York County', url: '/york-headshots/' },
      { label: 'Delaware', url: '/delaware-headshots/' },
    ]}
/>

<Gallery showButton={false}/>

  <ServicePanels
    headlineLines={panelHeadlineLines}
    headlineAccent={panelHeadlineAccent}
    whyTitle={whyTitle}
    whyParagraphs={whyParagraphs}
    experienceParagraphs={experienceParagraphs}
    expectationsParagraph={expectationsParagraph}
    facts={facts}
  />
  
   <div class="closing-sections">

  <section class="testimonials-section">

    <Testimonials2 title="Business Headshot Reviews" limit={3} filterByNames={["Chris Patille", "Emily Mainquist", "Ramiro Castillo"]}/>
    
  </section>


    <section class="faq-section" data-reveal>
      <FAQAccordion faqs={faqs}/>
    </section>

  </div>

</div>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
  const page = document.querySelector<HTMLElement>('.page');
  if (!page) return;
  if (window.location.pathname.replace(/\/$/, '') !== page.dataset.pagePath) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = gsap.context(() => {

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 16, duration: 1.4, ease: 'expo.out',
        /* the inline styles come off when the reveal ends, so the
           stylesheet's own transform on the card applies at every width,
           including after a resize */
        clearProps: 'opacity,transform',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true }
      });
    });

    /* The gallery assembles: every frame arrives in a random order rather
       than sweeping left to right, then the wall sits still. Nothing here
       touches Gallery.astro — it targets the markup from this page only. */
    const cells = gsap.utils.toArray<HTMLElement>('#gallery-section .gallery > div');
    if (cells.length) {
      gsap.from(cells, {
        opacity: 0,
        duration: 1.1,
        ease: 'expo.out',
        stagger: { each: 0.03, from: 'random' },
        scrollTrigger: { trigger: '#gallery-section', start: 'top 80%', once: true }
      });
    }


  }, page);

  window.addEventListener('load', () => ScrollTrigger.refresh());
  document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
});
</script>

<script>
import '../scripts/service-page-animations';
</script>

</MainLayout>

<style>
  body {
    background: #08080a;
    color: var(--ltclr);
  }

  /* One vertical rhythm for every section on the page. */
  .page {
    --section-space: clamp(4rem, 9vw, 8rem);
  }

  /* ==========================================
     BASE = PHONE
     Everything outside a media query is the phone layout. Tablet adds
     on at 48em (768px). Desktop adds on at 90em (1440px), the same
     width where ServiceHero switches to its two-column layout.
     ========================================== */

  /* The gallery sits on the page's one content edge, same as .wrapper.
     The shared component adds its own side padding and an inner width
     cap, which stacked three insets on a phone. Both are removed here
     and put back at desktop. */
  :global(div.page #gallery-section) {
    padding-inline: 0;
  }
  :global(#gallery-section .gallery-container) {
    padding-block: var(--section-space);
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  /* The shared gallery picks its columns from its container width, which
     was built for the desktop wrapper. This page sets the columns and
     which frames show at every breakpoint instead. Two-across on phones,
     as on the other service pages. */
  :global(#gallery-section .gallery) {
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--size-3);
  }

  .closing-sections {
    display: grid;
    align-content: center;
    min-height: 100vh;
    gap: var(--section-space);
    padding-block: var(--section-space);
    /* the fixed MENU bar and the chat bubble sit on the bottom of the
       screen, so the page ends with room for them under the last row */
    padding-block-end: calc(var(--section-space) + var(--size-5));
  }


  .testimonials-section {
    padding-block: 0;
  }
 

  /* ---------- the accordion, standing on the page on its own ---------- */

  /* the accordion sits on the page's content edge and runs narrower than
     the rest of the page at desktop, because question rows don't need the full
     content width */
  .faq-section {
    width: calc(100% - var(--size-8));
    max-width: 70rem;
    margin-inline: auto;
  }

  /* FAQAccordion ships with a top margin for the pages that use it with a
     heading above. This page has no heading, so the margin is removed here
     rather than in the shared component. */
  .faq-section :global(.faq-content) {
    margin-block-start: 0;
  }

  /* the questions are bold capitals, so they run 14px on a phone and grow
     back to the component's 16px by desktop */
  .faq-section :global(.question) {
    font-size: var(--fs-clamp-sm);
  }

  /* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
  @media (min-width: 48em) {

    /* four across, eight frames */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--size-3);
    }
    :global(#gallery-section .gallery .image1),
    :global(#gallery-section .gallery .image2),
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4),
    :global(#gallery-section .gallery .image5),
    :global(#gallery-section .gallery .image6),
    :global(#gallery-section .gallery .image7),
    :global(#gallery-section .gallery .image8) {
      display: block;
    }
    :global(#gallery-section .gallery .image9),
    :global(#gallery-section .gallery .image10),
    :global(#gallery-section .gallery .image11),
    :global(#gallery-section .gallery .image12),
    :global(#gallery-section .gallery .image13),
    :global(#gallery-section .gallery .image14),
    :global(#gallery-section .gallery .image15),
    :global(#gallery-section .gallery .image16) {
      display: none;
    }

  }

  /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     The sideways sliding, exactly as before.
     ========================================== */
  @media (min-width: 90em) {

    :global(div.page #gallery-section) {
      padding-inline: var(--size-8);
    }
    :global(#gallery-section .gallery-container) {
      /* width: 80%; */
    }
    /* three across, two rows, the six frames the gallery shows at 1440 */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-column-gap);
    }
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4) {
      display: none;
    }

  }


  

  /* ==========================================
     WIDE DESKTOP - min-width: 106.0625em (1697px)
     The width at which the gallery's container reaches 1025px and its
     full eight-across wall of sixteen frames begins.
     ========================================== */
  @media (min-width: 106.0625em) {

    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(8, 1fr);
    }
    :global(#gallery-section .gallery [class^="image"]) {
      display: block;
    }


    }


</style>
