---
// @ts-nocheck
import MainLayout from "../layouts/MainLayout.astro"
import Testimonials2 from '../components/Testimonials2.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Gallery from '../components/Gallery.astro';
import ServiceHero from '../components/service-pages/ServiceHero.astro';
import ServicePanels from '../components/service-pages/ServicePanels.astro';
import { buildServiceSchema, buildReviewSchema, buildFAQSchema } from '../utils/schema';
import { reviewCount, yearsExperience } from '../data/testimonials';

import JackCottrell from "../assets/images/features/Headshot_20220829_Jack Cottrell_Richard_Waine_Lancaster_PA_0318 (horizontal) - compressed.jpg"
import RW2 from "../assets/images/blog/RW7 - (16 x 9).jpg"


export interface Props {
  // SEO
  pageTitle?: string;
  metaDescription?: string;

  // Hero Section
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;

  // Blueprint Callouts
  callout1?: string;
  callout2?: string;

  // Button URLs
  heroButtonUrl?: string;

  // Service Panels
  panelHeadlineLines?: string[];
  panelHeadlineAccent?: string;
  whyTitle?: string;
  whyParagraphs?: string[];
  experienceParagraphs?: string[];
  expectationsParagraph?: string;
  facts?: { title: string; detail: string }[];
}

const {
  pageTitle = 'Acting Headshots and Performer Headshots | Richard Waine Photography',
  metaDescription = 'Professional acting and performer headshots for theatrical and commercial auditions. Expert expression coaching, real-time tethered review, strategic image selection',

  heroTitle = 'Acting',
  heroTitleAccent = 'Headshots',
  heroDescription = 'Every audition begins long before you enter the room. I create actor headshots that carry the weight of a performance, ensuring your first impression does the work of getting you called back.',
  heroButtonText = 'GET PRICING',
  SecondaryButtonText = 'SCHEDULE CONSULT',

  callout1 = 'CONFIDENCE',
  callout2 = 'CONNECTION',

  heroButtonUrl = '/rates',
  SecondaryButtonUrl = "https://app.acuityscheduling.com/schedule/f0843291/appointment/11959793/calendar/1133425?appointmentTypeIds[]=11959793",

  panelHeadlineLines = ["THE", "ACTOR", "HEADSHOT"],
  panelHeadlineAccent = "EXPERIENCE",
  whyTitle = "WHY ACTORS NEED PROFESSIONAL HEADSHOTS",
  whyParagraphs = [
    `Your acting headshots are the only part of your performance that enters the casting room before you do. When casting directors filter through hundreds of thumbnails in seconds, your image must do more than show what you look like. It must communicate your specific type, energy, and character range. Your photos act as your primary marketing asset and signal that you are a serious performer. The people making casting decisions use your photos to assess if you match what the production needs.`,

    `An image lacking depth or authentic expression creates a barrier between you and a potential audition. An amateur photo provides an easy reason for you to be overlooked in favor of talent who appear camera ready. Your acting photos compete against every other performer submitting for the same part. When your images grab attention, you're in the conversation for roles you want.`,

  ],


  experienceParagraphs = [
    `Getting professional headshots doesn't have to feel awkward or forced. My headshot sessions are conversational, collaborative and comfortable. The strongest images come from moments when you're engaged and present instead of overthinking it. Actors and performers tell me their headshot session was more enjoyable than they anticipated.`,

    `Most photographers tell you to relax and be yourself, then hope something good happens. I coach you through a deliberate process that elicits authentic expressions casting directors respond to.`,

    `I photograph tethered to a computer so images appear on a large screen during the session. We'll review your headshots together at key moments to make adjustments to expression, lighting, and posture. No waiting until after the session to see how things turned out. You leave knowing exactly what you're getting.`
  ],


  expectationsParagraph = `I don't expect you to know what to do with your hands, your chin, or your eyes. My job is to give you clear, specific direction that results in a natural, engaging presence on camera. I have specialized in actor headshots throughout my ${yearsExperience}-year career, so you get the nuance a generalist photographer misses. I have refined my directing approach to help you access authentic expressions that capture what makes you unique as a performer.`,

  facts = [
    { title: "Tethered Capture", detail: "Instant on-screen feedback" },
    { title: "Advanced Coaching", detail: "Guidance and direction" },
    { title: "Systematic Approach", detail: "Refined for actors" },
    { title: "Instant Review", detail: "Your choice of images" },
    { title: "Preparation Guide", detail: "Provided when you schedule" },
    { title: "Wardrobe Consultation", detail: "Purpose and color psychology" },
    { title: "No Time Limit", detail: "Nothing is rushed" },
    { title: "Professional Retouching", detail: "Included on every image" }
  ],

  faqs = [                                                                  
      {                                                                       
        question: "Should I lose weight before getting my headshot taken?",                                               
        answer: `The best time for your headshot is now. Casting directors want to see the real you, and waiting until you reach some future version of yourself means missing opportunities that exist today. Your headshot needs to match who walks through the door at auditions, which means representing yourself authentically as you are right now.

        <a href="/blog/what-is-a-professional-headshot/">Professional headshot sessions</a> are designed to present you at your most compelling, regardless of where you are with fitness goals or appearance concerns. I've worked with actors at every stage of their journey who felt the same hesitation. The breakthrough happens when you trust an experienced photographer to guide the process and show you what others already see. I wrote an entire article about <a href="/blog/should-i-wait-to-have-my-headshot-taken/">whether you should wait to get your headshot taken</a> that addresses appearance concerns, self-consciousness, and timing in depth.`                                                   
      },                                                                      
      {                                                                       
        question: "How often should actors update their headshots?",                                               
        answer: `Update your headshots every 1-2 years, or sooner if your appearance changes significantly. Your headshot represents your current look, and casting directors need accurate images that match who walks into the audition room. If your hairstyle, facial hair, weight, or overall appearance has shifted noticeably since your last session, your headshots are outdated.

        When your headshot doesn't match your current appearance, it creates immediate disconnect at auditions and callbacks. Casting directors form expectations based on your submitted images. Walking in looking different from your headshot damages trust before you've even started the audition. <a href="/blog/consistency-in-your-headshot/">Keeping your headshots current</a> shows you're actively managing your career and respecting the casting process.
        `                                                    
      },                                                                      
      {                                                                       
        question: "How do acting headshots differ from corporate headshots?",                                               
        answer: `Acting headshots and corporate headshots serve completely different professional objectives. Casting directors evaluate acting headshots for type, range, and character potential. They need to see if you can embody specific roles and bring authentic presence to auditions. Corporate headshots serve business credibility, approachability, and professional authority. Both require the same level of skill and attention, but the strategy behind each session addresses distinct career goals.
        `                                                    
      },
      {
        question: "Do I need multiple images for acting headshots?",
        answer: `Yes. Actors need multiple headshots to match different casting requirements. A single, universal image limits your ability to submit the most appropriate headshot for each audition. When casting directors request specific character types or energy levels, having a library of images means you can provide exactly what they're looking for rather than forcing one headshot to serve every role.

        How many images you select depends on your current career needs and casting goals. Some actors need images that serve theatrical versus commercial auditions. Others need variety that demonstrates range across character types. The session provides opportunities to create <a href="/blog/what-to-wear-for-headshots/">different expressions and looks</a>. You select the final images that best serve your specific casting requirements.
        `
      }                                                                       
    ]                    






} = Astro.props;

// Service schema
const actingHeadshotsServiceSchema = buildServiceSchema(
  "Acting Headshots",
  "Professional Acting Headshot Photography",
  "Professional acting headshots for performers, actors, and entertainers. High-quality theatrical headshots that capture your range and help you book more roles.",
  "Richard Waine Photography",
  "Lancaster",
  "PA",
  "+1-717-925-0061",
  ["Pennsylvania", "New York", "New Jersey", "Delaware", "Maryland", "Virginia"]
);

// Review schemas - 3 testimonials
const dillonBombaReview = buildReviewSchema(
  {
    author: "Dillon Bomba",
    company: "",
    rating: "5",
    reviewBody: "Rich made my first headshot experience so much fun. It was like seeing an old friend you've never met before. His direction is simple and effective. He can pull the most expressive faces from you with just a few words."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const cateCaplanReview = buildReviewSchema(
  {
    author: "Cate Caplan",
    company: "",
    rating: "5",
    reviewBody: "Richard takes the art of headshot photography to the next level. He actively engages his clients in the process far beyond the smile, and manages to create a fun, unparalleled experience. The final shots are of exceptional quality."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const brandonLesagoniczReview = buildReviewSchema(
  {
    author: "Brandon Lesagonicz",
    company: "",
    rating: "5",
    reviewBody: "Rich is without a doubt one of the most knowledgeable photographers I have ever worked with. Rocking out and fun! Whether it's a corporate occasion or just to update a model's portfolio anyone should absolutely work with him!"
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const actingHeadshotsFAQSchema = buildFAQSchema(faqs);

// This page's own address, filled in by Astro. The animation script reads it.
const pagePath = Astro.url.pathname.replace(/\/$/, '');

/* The figures at the foot of the hero. They describe the business, so they
   are the same on every service page. */
const spec = [
  { v: String(yearsExperience), l: "YEARS EXPERIENCE" },
  { v: String(reviewCount), l: "5-STAR GOOGLE REVIEWS" },
  { v: "10,000+", l: "HEADSHOTS DELIVERED" },
  { v: "100%", l: "CLIENT SATISFACTION" }
];
---




<MainLayout title={pageTitle} description={metaDescription}>

<!-- Service Schema -->
<script type="application/ld+json" set:html={JSON.stringify(actingHeadshotsServiceSchema)} />

<!-- Review Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(dillonBombaReview)} />
<script type="application/ld+json" set:html={JSON.stringify(cateCaplanReview)} />
<script type="application/ld+json" set:html={JSON.stringify(brandonLesagoniczReview)} />

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(actingHeadshotsFAQSchema)} />

<div class="page" data-page-path={pagePath}>

<ServiceHero
    heroTitle={heroTitle}
    heroTitleAccent={heroTitleAccent}
    heroDescription={heroDescription}
    heroButtonText={heroButtonText}
    heroButtonUrl={heroButtonUrl}
    secondaryButtonText={SecondaryButtonText}
    secondaryButtonUrl={SecondaryButtonUrl}
    heroBg={RW2}
    heroBgAlt="Professional headshot photographer Richard Waine photographing an actor in Lancaster PA studio with dual monitor setup displaying acting headshots"
    portraitImage={JackCottrell}
    portraitAlt="Professional actor headshot of young man with styled brown wavy hair and blue eyes wearing tan suede bomber jacket over black shirt on dark gray studio background by Richard Waine Photography"
    callout1={callout1}
    callout2={callout2}
    stats={spec}
    serviceAreaIntro="Serving actors in"
    serviceAreas={[
      { label: 'Lancaster', url: '/' },
      { label: 'Greater Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'Baltimore', url: '/baltimore-headshots/' },
      { label: 'Harrisburg', url: '/harrisburg-headshots/' },
      { label: 'York', url: '/york-headshots/' },
      { label: 'Wilmington', url: '/delaware-headshots/' },
    ]}
/>

<Gallery showButton={false}/>

  <ServicePanels
    headlineLines={panelHeadlineLines}
    headlineAccent={panelHeadlineAccent}
    whyTitle={whyTitle}
    whyParagraphs={whyParagraphs}
    experienceParagraphs={experienceParagraphs}
    expectationsParagraph={expectationsParagraph}
    facts={facts}
  />


   <div class="closing-sections">

  <section class="testimonials-section">

    <Testimonials2 title="Acting Headshot Reviews" limit={3} filterByNames={["Dillon Bomba", "Cate Caplan", "Brandon Lesagonicz"]}/>
    
  </section>


    <section class="faq-section" data-reveal>
      <FAQAccordion faqs={faqs}/>
    </section>

  </div>

</div>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
  const page = document.querySelector<HTMLElement>('.page');
  if (!page) return;
  if (window.location.pathname.replace(/\/$/, '') !== page.dataset.pagePath) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = gsap.context(() => {

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 16, duration: 1.4, ease: 'expo.out',
        /* the inline styles come off when the reveal ends, so the
           stylesheet's own transform on the card applies at every width,
           including after a resize */
        clearProps: 'opacity,transform',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true }
      });
    });

    /* The gallery assembles: every frame arrives in a random order rather
       than sweeping left to right, then the wall sits still. Nothing here
       touches Gallery.astro — it targets the markup from this page only. */
    const cells = gsap.utils.toArray<HTMLElement>('#gallery-section .gallery > div');
    if (cells.length) {
      gsap.from(cells, {
        opacity: 0,
        duration: 1.1,
        ease: 'expo.out',
        stagger: { each: 0.03, from: 'random' },
        scrollTrigger: { trigger: '#gallery-section', start: 'top 80%', once: true }
      });
    }


  }, page);

  window.addEventListener('load', () => ScrollTrigger.refresh());
  document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
});
</script>

<script>
import '../scripts/service-page-animations';
</script>


</MainLayout>


<style>
  body {
    background: #08080a;
    color: var(--ltclr);
  }

  /* One vertical rhythm for every section on the page. */
  .page {
    --section-space: clamp(4rem, 9vw, 8rem);
  }

  /* ==========================================
     BASE = PHONE
     Everything outside a media query is the phone layout. Tablet adds
     on at 48em (768px). Desktop adds on at 90em (1440px), the same
     width where ServiceHero switches to its two-column layout.
     ========================================== */

  /* The gallery sits on the page's one content edge, same as .wrapper.
     The shared component adds its own side padding and an inner width
     cap, which stacked three insets on a phone. Both are removed here
     and put back at desktop. */
  :global(div.page #gallery-section) {
    padding-inline: 0;
  }
  :global(#gallery-section .gallery-container) {
    padding-block: var(--section-space);
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  /* The shared gallery picks its columns from its container width, which
     was built for the desktop wrapper. This page sets the columns and
     which frames show at every breakpoint instead. Two-across on phones,
     as on the other service pages. */
  :global(#gallery-section .gallery) {
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--size-3);
  }

  .closing-sections {
    display: grid;
    align-content: center;
    min-height: 100vh;
    gap: var(--section-space);
    padding-block: var(--section-space);
    /* the fixed MENU bar and the chat bubble sit on the bottom of the
       screen, so the page ends with room for them under the last row */
    padding-block-end: calc(var(--section-space) + var(--size-5));
  }


  .testimonials-section {
    padding-block: 0;
  }
 

  /* ---------- the accordion, standing on the page on its own ---------- */

  /* the accordion sits on the page's content edge and runs narrower than
     the rest of the page at desktop, because question rows don't need the full
     content width */
  .faq-section {
    width: calc(100% - var(--size-8));
    max-width: 70rem;
    margin-inline: auto;
  }

  /* FAQAccordion ships with a top margin for the pages that use it with a
     heading above. This page has no heading, so the margin is removed here
     rather than in the shared component. */
  .faq-section :global(.faq-content) {
    margin-block-start: 0;
  }

  /* the questions are bold capitals, so they run 14px on a phone and grow
     back to the component's 16px by desktop */
  .faq-section :global(.question) {
    font-size: var(--fs-clamp-sm);
  }

  /* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
  @media (min-width: 48em) {

    /* four across, eight frames */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--size-3);
    }
    :global(#gallery-section .gallery .image1),
    :global(#gallery-section .gallery .image2),
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4),
    :global(#gallery-section .gallery .image5),
    :global(#gallery-section .gallery .image6),
    :global(#gallery-section .gallery .image7),
    :global(#gallery-section .gallery .image8) {
      display: block;
    }
    :global(#gallery-section .gallery .image9),
    :global(#gallery-section .gallery .image10),
    :global(#gallery-section .gallery .image11),
    :global(#gallery-section .gallery .image12),
    :global(#gallery-section .gallery .image13),
    :global(#gallery-section .gallery .image14),
    :global(#gallery-section .gallery .image15),
    :global(#gallery-section .gallery .image16) {
      display: none;
    }

  }

  /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     The sideways sliding, exactly as before.
     ========================================== */
  @media (min-width: 90em) {

    :global(div.page #gallery-section) {
      padding-inline: var(--size-8);
    }
    :global(#gallery-section .gallery-container) {
      /* width: 80%; */
    }
    /* three across, two rows, the six frames the gallery shows at 1440 */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-column-gap);
    }
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4) {
      display: none;
    }

  }


  

  /* ==========================================
     WIDE DESKTOP - min-width: 106.0625em (1697px)
     The width at which the gallery's container reaches 1025px and its
     full eight-across wall of sixteen frames begins.
     ========================================== */
  @media (min-width: 106.0625em) {

    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(8, 1fr);
    }
    :global(#gallery-section .gallery [class^="image"]) {
      display: block;
    }


    }


</style>
