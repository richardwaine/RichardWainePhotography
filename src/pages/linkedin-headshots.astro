---
// @ts-nocheck
import MainLayout from "../layouts/MainLayout.astro"
import Testimonials2 from '../components/Testimonials2.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Gallery from '../components/Gallery.astro';
import ServiceHero from '../components/service-pages/ServiceHero.astro';
import ServicePanels from '../components/service-pages/ServicePanels.astro';
import { buildServiceSchema, buildReviewSchema, buildFAQSchema } from '../utils/schema';
import { reviewCount, yearsExperience } from '../data/testimonials';

import KenGiglio from "../assets/images/features/Headshot_20180414_Ken Giglio_Richard_Waine_Lancaster_PA_0060-2 - compressed.jpg"
import RW2 from "../assets/images/blog/RW7 - (16 x 9).jpg"


export interface Props {
  // SEO
  pageTitle?: string;
  metaDescription?: string;

  // Hero Section
  heroTitle?: string;
  heroTitleAccent?: string;
  heroDescription?: string;
  heroButtonText?: string;

  // Blueprint Callouts
  callout1?: string;
  callout2?: string;

  // Button URLs
  heroButtonUrl?: string;

  // Service Panels
  panelHeadlineLines?: string[];
  panelHeadlineAccent?: string;
  whyTitle?: string;
  whyParagraphs?: string[];
  experienceParagraphs?: string[];
  expectationsParagraph?: string;
  facts?: { title: string; detail: string }[];
}

const {
  pageTitle = 'LinkedIn Headshots and Profile Photos | Richard Waine Photography',
  metaDescription = 'Professional LinkedIn headshots and LinkedIn profile photography for professionals, executives, entrepreneurs, and job seekers. Expert LinkedIn profile photos and headshot services',

  heroTitle = 'LinkedIn',
  heroTitleAccent = 'Headshots',
  heroDescription = 'Every professional interaction begins long before you introduce yourself. I create LinkedIn headshots that stop the scroll and establish a level of professional authority, making sure that when you show up in a search, you look like someone worth knowing.',
  heroButtonText = 'GET PRICING',
  SecondaryButtonText = 'SCHEDULE CONSULT',

  callout1 = 'PROFESSIONALISM',
  callout2 = 'COMPETENCE',

  heroButtonUrl = '/rates',
  SecondaryButtonUrl = "https://app.acuityscheduling.com/schedule/f0843291/appointment/11959793/calendar/1133425?appointmentTypeIds[]=11959793",

  // Service Panels (the three sliding panels)
  panelHeadlineLines = ["THE", "LINKEDIN", "HEADSHOT"],
  panelHeadlineAccent = "EXPERIENCE",
  whyTitle = "WHY YOU NEED A PROFESSIONAL LINKEDIN HEADSHOT",
  whyParagraphs = [

    `Your LinkedIn profile photo is not optional decoration. It is a primary factor in how often your profile is found, how recruiters evaluate your credibility, and whether you are taken seriously as a professional. LinkedIn's algorithm prioritizes complete profiles, and a professional headshot is one of the most important signals the platform uses to determine profile quality. A high-quality headshot dramatically increases the likelihood that your profile appears in search results.`,

    `Recruiters spend nearly 20% of their review time looking at your photo before they read your experience or qualifications. This means your headshot functions as a screening filter. The difference between a professional image and an amateur photo is not just technical quality. It is the message you send about your commitment to your career and how you want to be perceived.`,

  ],
  experienceParagraphs = [
    `Most professionals approach their LinkedIn headshot session with apprehension. My headshot sessions eliminate that tension by creating an environment that feels more like a conversation with a trusted friend than a formal photo shoot. Music plays, we laugh, and the direction I provide feels natural rather than forced. Most people are surprised by how much they enjoy the process.`,

    `Your profile photo acts as the visual anchor for your professional history. When that business portrait is forced and lacks authenticity, it contradicts the experience listed in your background. Coaching your facial expression to capture poise and confidence, we produce a LinkedIn headshot that looks like the person described on your resume and in your LinkedIn profile.`,

    `Images are reviewed as they are created to refine presence, approachability, and authority. Rather than expecting you to know what to do in front of the camera, I guide your posture, expression, and positioning so nothing is left to chance. You leave with a headshot that supports how you want to be perceived the moment someone views your profile.`,

  ],
  expectationsParagraph = `Standing in front of a camera for a professional headshot can feel unnatural and vulnerable. Clear, specific direction ensures that each movement and position demonstrates your approachability, confidence, and professionalism. Small, precise adjustments, a subtle tilt of the head, a shift in your shoulders, the placement of your hands, dramatically influence the final result. In my ${yearsExperience} years photographing professionals for LinkedIn, I have refined this directing approach to eliminate the stiffness that makes headshots look uncomfortable and staged.`,

  facts = [
    { title: "Tethered Capture", detail: "Instant on-screen feedback" },
    { title: "Advanced Coaching", detail: "Guidance and direction" },
    { title: "Systematic Approach", detail: "Refined for LinkedIn" },
    { title: "Instant Review", detail: "Your choice of images" },
    { title: "Preparation Guide", detail: "Provided when you schedule" },
    { title: "Wardrobe Consultation", detail: "Purpose and color psychology" },
    { title: "No Time Limit", detail: "Nothing is rushed" },
    { title: "Professional Retouching", detail: "Included on every image" }
  ],

  faqs = [                                                                  
      {                                                                       
        question: "Will recruiters take you less seriously with a bad headshot?",                                               
        answer: `Yes. A bad headshot functions as a primary screening filter that leads to immediate disqualification. Research from Ladders using eye tracking technology proves that recruiters spend 19% of their total profile review time looking at your photo. If the image is unprofessional, they are statistically less likely to even read your experience. This is supported by data from CareerBuilder, which found that 71% of hiring managers have rejected candidates based on their online professional presence, citing a poor headshot as a sign of low professional judgment and a lack of attention to detail.

        Furthermore, a professional headshot signals a willingness to invest in yourself. Recruiters view a high quality image as evidence that you take your career and personal brand seriously and are committed to presenting yourself as a polished professional. Using a low effort or low quality photo suggests a lack of self investment, leading hiring managers to question whether you will apply that same lack of effort to your work. A <a href="/blog/what-is-a-professional-headshot/">professional headshot</a> photo removes that doubt by demonstrating that you value your own professional brand.  
        `                                                   
      },                                                                      
      {                                                                       
        question: "Why choose a professional session over an AI headshot?",                                               
        answer: `AI headshots might cost less, but they are a poor investment because they are completely contrived fabrications. Business happens when people know, like, and trust you, and a professional headshot facilitates that trust by providing an accurate representation of your appearance, personality, and style. By choosing AI, you sacrifice the skill, ability, knowledge, professional equipment, and collaboration required to capture your professionalism and message, in exchange for a few pennies saved.

        While an algorithm simply regurgitates indexed data without coaching or direction, I work with you in real time to elicit genuine facial expressions. AI headshots are just cheap renditions of what a computer thinks you should look like or how it thinks society should see you. Whereas I provide the expert guidance, nuanced lighting, and intentional composition needed to ensure the resulting image truly represents you. You gain a reliable, trusted collaborator and confidant who actively listens to your concerns, has a vested interest in your success, and tailors the final images to best suit your needs.

        AI cannot replicate the human interaction required to make you feel comfortable or to ensure the final product looks like the person who actually shows up to the meeting. By choosing a professional headshot session, you are choosing a relatable, authentic image and a dedicated service experience over a guess made by software that lacks any real human element. Not only do you get a specialist determined to align with your goals, but you ensure a smooth, enjoyable experience rather than wasting valuable resources on a fabricated result.

        `                                                    
      },                                                                      
      {                                                                       
        question: "What is the best background for a LinkedIn headshot in 2026?",                                               
        answer: `<a href="/blog/best-backgrounds-for-professional-headshots/">The best background for headshots for your LinkedIn profile</a> is one that keeps the focus on you, not what's behind you. Solid backgrounds work best because they eliminate distractions. White, grey, and black are the most popular choices. I also offer hand-painted canvas backgrounds in various colors if you want something with subtle texture.

        During your session, we'll collaborate on background selection through discussion and strategic choices, similar to how we approach clothing options. The most important factor is making sure nothing pulls attention away from your face and expression.
        `                                                    
      },
      {
        question: "Why do LinkedIn profiles with headshots perform better?",
        answer: `According to LinkedIn, profiles with professional headshots receive up to 14 to 21 times more profile views, up to 36 times more messages, and about nine times more connection requests compared to profiles without photos. This increase is driven not just by platform algorithms but by human behavior. People respond to professional images that show credibility, competence, and approachability. A high-quality headshot helps your profile attract attention from recruiters, clients, and collaborators.

        Independent research also supports these findings. A study published in the Online Journal of Communication and Media Technologies found that LinkedIn users with profile pictures are perceived as more competent and socially attractive than those without photos. Professional headshots also improve profile completeness, which LinkedIn favors in search results and recommendations. Together these factors contribute to more visibility, connections, and professional authority.
        `
      }                                                                       
    ]                    

} = Astro.props;

// Service schema
const linkedinHeadshotsServiceSchema = buildServiceSchema(
  "LinkedIn Headshots",
  "Professional LinkedIn Headshot Photography",
  "Professional LinkedIn headshots that make you stand out. Optimized profile photos that enhance your professional brand and attract opportunities.",
  "Richard Waine Photography",
  "Lancaster",
  "PA",
  "+1-717-925-0061",
  ["Pennsylvania", "New York", "New Jersey", "Delaware", "Maryland", "Virginia"]
);

// Review schemas - 3 testimonials
const andrewJacobsReview = buildReviewSchema(
  {
    author: "Andrew Jacobs",
    company: "Turkey Hill",
    rating: "5",
    reviewBody: "Richard is a true professional and I greatly enjoyed my experience working with him. He provided a clear instructions and made the entire experience fun and enjoyable. If you need headshots I highly recommend Richard Waine"
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const julieEvansReview = buildReviewSchema(
  {
    author: "Julie Evans",
    company: "Claritas HR",
    rating: "5",
    reviewBody: "Rich provided way more than I expected, but somehow just what I needed. He helped me see clearly who I intend to be as a business professional and even more as a person. Impressed is an understatement."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const nolanFosterReview = buildReviewSchema(
  {
    author: "Nolan Foster",
    company: "Bursera Capital",
    rating: "5",
    reviewBody: "When someone says 'a master of their craft' they typically refer to individuals like Steve Jobs, Leonardo, and Socrates. They were all masters, but I bet they couldn't take photos as good as Richard Waine can."
  },
  "Richard Waine Photography",
  "https://richardwainephotography.com"
);

const linkedinHeadshotsFAQSchema = buildFAQSchema(faqs);

// This page's own address, filled in by Astro. The animation script reads it.
const pagePath = Astro.url.pathname.replace(/\/$/, '');

/* The figures at the foot of the hero. They describe the business, so they
   are the same on every service page. */
const spec = [
  { v: String(yearsExperience), l: "YEARS EXPERIENCE" },
  { v: String(reviewCount), l: "5-STAR GOOGLE REVIEWS" },
  { v: "10,000+", l: "HEADSHOTS DELIVERED" },
  { v: "100%", l: "CLIENT SATISFACTION" }
];
---




<MainLayout title={pageTitle} description={metaDescription}>

<!-- Service Schema -->
<script type="application/ld+json" set:html={JSON.stringify(linkedinHeadshotsServiceSchema)} />

<!-- Review Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(andrewJacobsReview)} />
<script type="application/ld+json" set:html={JSON.stringify(julieEvansReview)} />
<script type="application/ld+json" set:html={JSON.stringify(nolanFosterReview)} />

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify(linkedinHeadshotsFAQSchema)} />

<div class="page" data-page-path={pagePath}>

<ServiceHero
    heroTitle={heroTitle}
    heroTitleAccent={heroTitleAccent}
    heroDescription={heroDescription}
    heroButtonText={heroButtonText}
    heroButtonUrl={heroButtonUrl}
    secondaryButtonText={SecondaryButtonText}
    secondaryButtonUrl={SecondaryButtonUrl}
    heroBg={RW2}
    heroBgAlt="Professional headshot photographer Richard Waine photographing a client in Lancaster PA studio with dual monitor setup displaying headshots for Linkedin profiles"
    portraitImage={KenGiglio}
    portraitAlt="Professional linkedin profile headshot of man with gray mustache and shaved head wearing black suit jacket and white open-collar dress shirt on white studio background by Richard Waine Photography"
    callout1={callout1}
    callout2={callout2}
    stats={spec}
    serviceAreaIntro="Serving career professionals in"
    serviceAreas={[
      { label: 'Lancaster', url: '/' },
      { label: 'Philadelphia', url: '/philadelphia-headshots/' },
      { label: 'Baltimore', url: '/baltimore-headshots/' },
      { label: 'Harrisburg area', url: '/harrisburg-headshots/' },
      { label: 'York County', url: '/york-headshots/' },
      { label: 'Newark, DE', url: '/delaware-headshots/' },
    ]}
/>

<Gallery showButton={false}/>

  <ServicePanels
    headlineLines={panelHeadlineLines}
    headlineAccent={panelHeadlineAccent}
    whyTitle={whyTitle}
    whyParagraphs={whyParagraphs}
    experienceParagraphs={experienceParagraphs}
    expectationsParagraph={expectationsParagraph}
    facts={facts}
  />
  
   <div class="closing-sections">

  <section class="testimonials-section">

    <Testimonials2 title="LinkedIn Headshot Reviews" limit={3} filterByNames={["Andrew Jacobs", "Julie Evans", "Nolan Foster"]}/>
    
  </section>


    <section class="faq-section" data-reveal>
      <FAQAccordion faqs={faqs}/>
    </section>

  </div>

</div>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

document.addEventListener('astro:page-load', () => {
  const page = document.querySelector<HTMLElement>('.page');
  if (!page) return;
  if (window.location.pathname.replace(/\/$/, '') !== page.dataset.pagePath) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = gsap.context(() => {

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 16, duration: 1.4, ease: 'expo.out',
        /* the inline styles come off when the reveal ends, so the
           stylesheet's own transform on the card applies at every width,
           including after a resize */
        clearProps: 'opacity,transform',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true }
      });
    });

    /* The gallery assembles: every frame arrives in a random order rather
       than sweeping left to right, then the wall sits still. Nothing here
       touches Gallery.astro — it targets the markup from this page only. */
    const cells = gsap.utils.toArray<HTMLElement>('#gallery-section .gallery > div');
    if (cells.length) {
      gsap.from(cells, {
        opacity: 0,
        duration: 1.1,
        ease: 'expo.out',
        stagger: { each: 0.03, from: 'random' },
        scrollTrigger: { trigger: '#gallery-section', start: 'top 80%', once: true }
      });
    }


  }, page);

  window.addEventListener('load', () => ScrollTrigger.refresh());
  document.addEventListener('astro:before-swap', () => ctx.revert(), { once: true });
});
</script>

<script>
import '../scripts/service-page-animations';
</script>


</MainLayout>


<style>
  body {
    background: #08080a;
    color: var(--ltclr);
  }

  /* One vertical rhythm for every section on the page. */
  .page {
    --section-space: clamp(4rem, 9vw, 8rem);
  }

  /* ==========================================
     BASE = PHONE
     Everything outside a media query is the phone layout. Tablet adds
     on at 48em (768px). Desktop adds on at 90em (1440px), the same
     width where ServiceHero switches to its two-column layout.
     ========================================== */

  /* The gallery sits on the page's one content edge, same as .wrapper.
     The shared component adds its own side padding and an inner width
     cap, which stacked three insets on a phone. Both are removed here
     and put back at desktop. */
  :global(div.page #gallery-section) {
    padding-inline: 0;
  }
  :global(#gallery-section .gallery-container) {
    padding-block: var(--section-space);
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  /* The shared gallery picks its columns from its container width, which
     was built for the desktop wrapper. This page sets the columns and
     which frames show at every breakpoint instead. Two-across on phones,
     as on the other service pages. */
  :global(#gallery-section .gallery) {
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--size-3);
  }

  .closing-sections {
    display: grid;
    align-content: center;
    min-height: 100vh;
    gap: var(--section-space);
    padding-block: var(--section-space);
    /* the fixed MENU bar and the chat bubble sit on the bottom of the
       screen, so the page ends with room for them under the last row */
    padding-block-end: calc(var(--section-space) + var(--size-5));
  }


  .testimonials-section {
    padding-block: 0;
  }
 

  /* ---------- the accordion, standing on the page on its own ---------- */

  /* the accordion sits on the page's content edge and runs narrower than
     the rest of the page at desktop, because question rows don't need the full
     content width */
  .faq-section {
    width: calc(100% - var(--size-8));
    max-width: 70rem;
    margin-inline: auto;
  }

  /* FAQAccordion ships with a top margin for the pages that use it with a
     heading above. This page has no heading, so the margin is removed here
     rather than in the shared component. */
  .faq-section :global(.faq-content) {
    margin-block-start: 0;
  }

  /* the questions are bold capitals, so they run 14px on a phone and grow
     back to the component's 16px by desktop */
  .faq-section :global(.question) {
    font-size: var(--fs-clamp-sm);
  }

  /* ==========================================
     TABLET - min-width: 48em (768px)
     ========================================== */
  @media (min-width: 48em) {

    /* four across, eight frames */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--size-3);
    }
    :global(#gallery-section .gallery .image1),
    :global(#gallery-section .gallery .image2),
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4),
    :global(#gallery-section .gallery .image5),
    :global(#gallery-section .gallery .image6),
    :global(#gallery-section .gallery .image7),
    :global(#gallery-section .gallery .image8) {
      display: block;
    }
    :global(#gallery-section .gallery .image9),
    :global(#gallery-section .gallery .image10),
    :global(#gallery-section .gallery .image11),
    :global(#gallery-section .gallery .image12),
    :global(#gallery-section .gallery .image13),
    :global(#gallery-section .gallery .image14),
    :global(#gallery-section .gallery .image15),
    :global(#gallery-section .gallery .image16) {
      display: none;
    }

  }

  /* ==========================================
     DESKTOP - min-width: 90em (1440px)
     The sideways sliding, exactly as before.
     ========================================== */
  @media (min-width: 90em) {

    :global(div.page #gallery-section) {
      padding-inline: var(--size-8);
    }
    :global(#gallery-section .gallery-container) {
      /* width: 80%; */
    }
    /* three across, two rows, the six frames the gallery shows at 1440 */
    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-column-gap);
    }
    :global(#gallery-section .gallery .image3),
    :global(#gallery-section .gallery .image4) {
      display: none;
    }

  }


  

  /* ==========================================
     WIDE DESKTOP - min-width: 106.0625em (1697px)
     The width at which the gallery's container reaches 1025px and its
     full eight-across wall of sixteen frames begins.
     ========================================== */
  @media (min-width: 106.0625em) {

    :global(#gallery-section .gallery) {
      grid-template-columns: repeat(8, 1fr);
    }
    :global(#gallery-section .gallery [class^="image"]) {
      display: block;
    }


    }

</style>
